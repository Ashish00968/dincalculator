---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    {/* Page Header */}
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-parchment border border-hairline text-ink text-xs font-semibold mb-4 shadow-sm uppercase tracking-widest">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>{c.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold text-ink tracking-tight mb-4">
        {c.h1}
      </h1>
      <p class="text-mute text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        {c.subtitle}
      </p>

      {/* Trust & Meta Info */}
      <div class="mt-4 flex flex-wrap items-center justify-center gap-4 text-xs text-mute font-mono">
        <span>Standard: ISO 11088:2023 (Ed. 7)</span>
        <span>•</span>
        <span>{c.reviewedBy}</span>
        <span>•</span>
        <a href={getRouteFromUrl(new URL('/methodology/', siteUrl), lang)} class="underline hover:text-primary">{c.methodologyLink}</a>
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={getRouteFromUrl(new URL('/', siteUrl), lang)}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-primary hover:scale-[0.98] text-canvas font-medium text-sm transition-transform shadow-md cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          {t('cta.interactiveCalc')}
        </a>
        <button
          onclick="window.print()"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-canvas hover:border-primary/50 border border-hairline text-ink font-medium text-sm transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4 text-mute" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          {t('cta.printMatrix')}
        </button>
      </div>
    </div>

    {/* What Changed in ISO 11088:2023 Callout */}
    <div class="mb-12 p-6 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-ink">
      <div class="flex items-start gap-4">
        <div class="p-2 rounded-xl bg-amber-500/20 text-amber-800 dark:text-amber-300 shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="space-y-1">
          <h2 class="text-base font-semibold text-ink">{c.changesTitle}</h2>
          <p class="text-sm text-mute leading-relaxed">
            {c.changesDesc} <a href={getRouteFromUrl(new URL('/iso-11088-2023-changes/', siteUrl), lang)} class="text-primary underline font-medium">{c.changesLinkText}</a>.
          </p>
        </div>
      </div>
    </div>

    {/* 3-Step Quick Reading Guide */}
    <div class="mb-12 grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-5 rounded-2xl bg-canvas border border-hairline space-y-2">
        <div class="text-primary font-mono font-bold text-xs uppercase tracking-wider">{c.stepPrefix} 1</div>
        <h3 class="font-semibold text-ink text-sm">{c.step1Title}</h3>
        <p class="text-xs text-mute leading-relaxed">{c.step1Desc}</p>
      </div>
      <div class="p-5 rounded-2xl bg-canvas border border-hairline space-y-2">
        <div class="text-primary font-mono font-bold text-xs uppercase tracking-wider">{c.stepPrefix} 2</div>
        <h3 class="font-semibold text-ink text-sm">{c.step2Title}</h3>
        <p class="text-xs text-mute leading-relaxed">{c.step2Desc}</p>
      </div>
      <div class="p-5 rounded-2xl bg-canvas border border-hairline space-y-2">
        <div class="text-primary font-mono font-bold text-xs uppercase tracking-wider">{c.stepPrefix} 3</div>
        <h3 class="font-semibold text-ink text-sm">{c.step3Title}</h3>
        <p class="text-xs text-mute leading-relaxed">{c.step3Desc}</p>
      </div>
    </div>

    {/* Interactive Reference Matrix Table */}
    <div class="mb-16">
      <MatrixTable client:visible result={null} lang={lang} />
    </div>

    {/* Worked Example Card */}
    <div class="mb-16 p-6 sm:p-8 rounded-2xl bg-canvas border border-hairline space-y-4">
      <h2 class="text-lg font-bold text-ink flex items-center gap-2">
        <span>{c.workedTitle}</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-mono">
        <div class="p-3 rounded-xl bg-parchment border border-hairline">
          <div class="text-mute mb-1">{c.profileLabel}</div>
          <div class="font-bold text-ink">{c.profileVal}</div>
        </div>
        <div class="p-3 rounded-xl bg-parchment border border-hairline">
          <div class="text-mute mb-1">{c.baseCodeLabel}</div>
          <div class="font-bold text-ink">{c.baseCodeVal}</div>
        </div>
        <div class="p-3 rounded-xl bg-parchment border border-hairline">
          <div class="text-mute mb-1">{c.modifierLabel}</div>
          <div class="font-bold text-primary">{c.modifierVal}</div>
        </div>
        <div class="p-3 rounded-xl bg-parchment border border-hairline">
          <div class="text-mute mb-1">{c.settingLabel}</div>
          <div class="font-bold text-emerald-700 dark:text-emerald-400">{c.settingVal}</div>
        </div>
      </div>
      <p class="text-xs text-mute leading-relaxed" set:html={c.traceDesc} />
    </div>

    {/* Educational Guide on ISO 11088 Logic */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-ink">
      <div class="p-8 rounded-[24px] bg-parchment border border-hairline space-y-4 shadow-sm">
        <h2 class="text-lg font-semibold text-ink flex items-center gap-3">
          <span class="w-8 h-8 rounded-full bg-canvas border border-hairline text-ink flex items-center justify-center text-sm font-semibold">1</span>
          {c.card1Title}
        </h2>
        <p class="text-sm text-mute leading-relaxed" set:html={c.card1P1} />
        <div class="p-4 rounded-[16px] bg-canvas border border-hairline text-sm space-y-1">
          <p class="font-semibold text-ink">{c.card1RuleTitle}</p>
          <p class="text-mute text-xs" set:html={c.card1RuleDesc} />
        </div>
      </div>

      <div class="p-8 rounded-[24px] bg-parchment border border-hairline space-y-4 shadow-sm">
        <h2 class="text-lg font-semibold text-ink flex items-center gap-3">
          <span class="w-8 h-8 rounded-full bg-canvas border border-hairline text-ink flex items-center justify-center text-sm font-semibold">2</span>
          {c.card2Title}
        </h2>
        <p class="text-sm text-mute leading-relaxed">
          {c.card2P1}
        </p>
        <ul class="text-xs space-y-2 text-ink font-mono mt-4">
          <li class="flex items-center justify-between p-3 rounded-lg bg-canvas border border-hairline">
            <span>{c.typeMinus1}</span>
            <span class="text-emerald-700 dark:text-emerald-400 font-semibold">{c.stepMinus1}</span>
          </li>
          <li class="flex items-center justify-between p-3 rounded-lg bg-canvas border border-hairline">
            <span>{c.type1}</span>
            <span class="text-mute">{c.step0}</span>
          </li>
          <li class="flex items-center justify-between p-3 rounded-lg bg-canvas border border-hairline">
            <span>{c.type2}</span>
            <span class="text-primary font-semibold">{c.stepPlus1}</span>
          </li>
          <li class="flex items-center justify-between p-3 rounded-lg bg-canvas border border-hairline">
            <span>{c.type3}</span>
            <span class="text-amber-800 dark:text-amber-300 font-semibold">{c.stepPlus2}</span>
          </li>
          <li class="flex items-center justify-between p-3 rounded-lg bg-canvas border border-hairline">
            <span>{c.ageMod}</span>
            <span class="text-emerald-700 dark:text-emerald-400 font-semibold">{c.stepMinus1}</span>
          </li>
        </ul>
      </div>

      <div class="p-8 rounded-[24px] bg-parchment border border-hairline space-y-4 md:col-span-2 shadow-sm">
        <h2 class="text-lg font-semibold text-ink flex items-center gap-3">
          <span class="w-8 h-8 rounded-full bg-canvas border border-hairline text-ink flex items-center justify-center text-sm font-semibold">3</span>
          {c.card3Title}
        </h2>
        <p class="text-sm text-mute leading-relaxed" set:html={c.card3P1} />
      </div>

      {/* Primary Sources & Standard Citations */}
      <div class="p-8 rounded-[24px] bg-canvas border border-hairline space-y-4 md:col-span-2">
        <h2 class="text-base font-semibold text-ink">{c.standardsTitle}</h2>
        <ul class="text-xs text-mute space-y-2 leading-relaxed">
          <li>• <strong>{c.isoTitle}</strong> <em>{c.isoDesc}</em> — International Organization for Standardization (<a href="https://www.iso.org/standard/83020.html" target="_blank" rel="noopener noreferrer" class="underline hover:text-primary">iso.org/standard/83020</a>).</li>
          <li>• <strong>{c.astmF939Title}</strong> <em>{c.astmF939Desc}</em></li>
          <li>• <strong>{c.astmF1063Title}</strong> <em>{c.astmF1063Desc}</em></li>
          <li>• <strong>{c.iso9462Title}</strong> <em>{c.iso9462Desc}</em></li>
        </ul>
        <div class="pt-4 border-t border-hairline text-xs text-mute">
          <strong>{c.safetyTitle}</strong> {c.safetyDesc}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
