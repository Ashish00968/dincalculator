---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MatrixTable } from '../calculator/MatrixTable';
import { useTranslations, getRouteFromUrl } from '../../i18n/utils';
import type { ui } from '../../i18n/ui';

interface Props {
  lang?: keyof typeof ui;
}

const { lang = (Astro.params.lang as keyof typeof ui) || 'en' } = Astro.props;
const t = useTranslations(lang);
const siteUrl = 'https://dincalculatorpro.com';

const pageTitle = t('page.matrix.title');
const pageDescription = t('page.matrix.desc');
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    {/* Page Header */}
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-parchment border border-hairline text-ink text-xs font-semibold mb-4 shadow-sm uppercase tracking-widest">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>
          {lang === 'de' ? 'ISO 11088:2023 Tabelle 2 Z-Wert Matrix' : lang === 'fr' ? 'Matrice Tableau 2 ISO 11088:2023' : lang === 'it' ? 'Matrice Tabella 2 ISO 11088:2023' : 'ISO 11088:2023 Standard Table 2 Matrix'}
        </span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold text-ink tracking-tight mb-4">
        {lang === 'de' ? 'Z-Wert Tabelle Skibindung (ISO 11088:2023)' : lang === 'fr' ? 'Tableau DIN Fixations de Ski (ISO 11088:2023)' : lang === 'it' ? 'Tabella DIN Attacchi Sci (ISO 11088:2023)' : 'Ski Binding DIN Chart (ISO 11088:2023)'}
      </h1>
      <p class="text-mute text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        {lang === 'de' 
          ? 'Die internationale Referenztabelle der Skiservice-Werkstätten zur Ermittlung des Auslösemoments anhand von Fahrercode und Skischuh-Sohlenlänge in Millimetern.'
          : lang === 'fr'
          ? 'La grille de référence internationale utilisée en atelier pour déterminer le réglage de déclenchement selon le code skieur et la longueur de semelle.'
          : lang === 'it'
          ? 'La matrice di riferimento internazionale impiegata dai laboratori sci per definire la coppia di rilascio in base al codice sciatore e alla lunghezza scafo in millimetri.'
          : 'The international standard matrix used by ski service workshops to determine release torque settings based on skier code and boot sole millimeter length.'}
      </p>

      {/* Trust & Meta Info */}
      <div class="mt-4 flex flex-wrap items-center justify-center gap-4 text-xs text-mute font-mono">
        <span>Standard: ISO 11088:2023 (Ed. 7)</span>
        <span>•</span>
        <span>Reviewed by Ski Tech Team</span>
        <span>•</span>
        <a href="/methodology/" class="underline hover:text-primary">Calculation Methodology</a>
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={getRouteFromUrl(new URL('/', siteUrl), lang)}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-primary hover:scale-[0.98] text-canvas font-medium text-sm transition-transform shadow-md cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          {t('cta.interactiveCalc')}
        </a>
        <button
          onclick="window.print()"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-canvas hover:border-primary/50 border border-hairline text-ink font-medium text-sm transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4 text-mute" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          {t('cta.printMatrix')}
        </button>
      </div>
    </div>

    {/* What Changed in ISO 11088:2023 Callout */}
    <div class="mb-12 p-6 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-ink">
      <div class="flex items-start gap-4">
        <div class="p-2 rounded-xl bg-amber-500/20 text-amber-600 shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="space-y-1">
          <h2 class="text-base font-semibold text-ink">What changed in the ISO 11088:2023 7th Edition?</h2>
          <p class="text-sm text-mute leading-relaxed">
            The 7th Edition of ISO 11088 (published 2023) established formal boot-binding interface classification tables (incorporating GripWalk ISO 23223 alongside Alpine ISO 5355 and Touring ISO 9523) and updated workshop inspection tolerances. Learn full details in our <a href="/iso-11088-2023-changes/" class="text-primary underline font-medium">ISO 11088:2023 Changes Breakdown</a>.
          </p>
        </div>
      </div>
    </div>

    {/* 3-Step Quick Reading Guide */}
    <div class="mb-12 grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-5 rounded-2xl bg-canvas border border-hairline space-y-2">
        <div class="text-primary font-mono font-bold text-xs uppercase tracking-wider">Step 1</div>
        <h3 class="font-semibold text-ink text-sm">Find Skier Code</h3>
        <p class="text-xs text-mute leading-relaxed">Look up body weight and height. If they point to different rows, select the upper row (lower letter) for safety.</p>
      </div>
      <div class="p-5 rounded-2xl bg-canvas border border-hairline space-y-2">
        <div class="text-primary font-mono font-bold text-xs uppercase tracking-wider">Step 2</div>
        <h3 class="font-semibold text-ink text-sm">Apply Modifiers</h3>
        <p class="text-xs text-mute leading-relaxed">Adjust row for Skier Type (Type II: +1, Type III: +2) and age (under 10 or 50+: shift 1 row up).</p>
      </div>
      <div class="p-5 rounded-2xl bg-canvas border border-hairline space-y-2">
        <div class="text-primary font-mono font-bold text-xs uppercase tracking-wider">Step 3</div>
        <h3 class="font-semibold text-ink text-sm">Cross-Reference BSL</h3>
        <p class="text-xs text-mute leading-relaxed">Trace right along the final code row until you reach your boot sole length (BSL) column in millimeters.</p>
      </div>
    </div>

    {/* Interactive Reference Matrix Table */}
    <div class="mb-16">
      <MatrixTable client:visible result={null} lang={lang} />
    </div>

    {/* Worked Example Card */}
    <div class="mb-16 p-6 sm:p-8 rounded-2xl bg-canvas border border-hairline space-y-4">
      <h2 class="text-lg font-bold text-ink flex items-center gap-2">
        <span>Worked Example: 75 kg All-Mountain Skier</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-mono">
        <div class="p-3 rounded-xl bg-parchment border border-hairline">
          <div class="text-mute mb-1">Skier Profile</div>
          <div class="font-bold text-ink">75 kg · 178 cm · 30 yrs</div>
        </div>
        <div class="p-3 rounded-xl bg-parchment border border-hairline">
          <div class="text-mute mb-1">Baseline Code</div>
          <div class="font-bold text-ink">Weight Code K (67–78 kg)</div>
        </div>
        <div class="p-3 rounded-xl bg-parchment border border-hairline">
          <div class="text-mute mb-1">Type II Modifier</div>
          <div class="font-bold text-primary">+1 Row &rarr; Code L</div>
        </div>
        <div class="p-3 rounded-xl bg-parchment border border-hairline">
          <div class="text-mute mb-1">BSL 305mm Setting</div>
          <div class="font-bold text-emerald-500">DIN 6.5 (58–71 Nm)</div>
        </div>
      </div>
      <p class="text-xs text-mute leading-relaxed">
        Trace: Code L across to the 291–310 mm BSL column produces exactly <strong>6.5</strong> on the standardized scale.
      </p>
    </div>

    {/* Educational Guide on ISO 11088 Logic */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-ink">
      <div class="p-8 rounded-[24px] bg-parchment border border-hairline space-y-4 shadow-sm">
        <h2 class="text-lg font-semibold text-ink flex items-center gap-3">
          <span class="w-8 h-8 rounded-full bg-canvas border border-hairline text-ink flex items-center justify-center text-sm font-semibold">1</span>
          Baseline Skier Codes (A to P)
        </h2>
        <p class="text-sm text-mute leading-relaxed">
          The ISO 11088 system begins by mapping a skier's body mass (weight) and height to an alphabetic row letter from <strong>Code A</strong> (children 10–13 kg) through <strong>Code P</strong> (extreme racers).
        </p>
        <div class="p-4 rounded-[16px] bg-canvas border border-hairline text-sm space-y-1">
          <p class="font-semibold text-ink">The Conflict Resolution Rule:</p>
          <p class="text-mute text-xs">
            If weight gives one code (e.g. Code J) and height gives another (e.g. Code K), ISO 11088 mandates choosing the <strong>higher row in the chart (lower letter = lower release torque)</strong> for safety.
          </p>
        </div>
      </div>

      <div class="p-8 rounded-[24px] bg-parchment border border-hairline space-y-4 shadow-sm">
        <h2 class="text-lg font-semibold text-ink flex items-center gap-3">
          <span class="w-8 h-8 rounded-full bg-canvas border border-hairline text-ink flex items-center justify-center text-sm font-semibold">2</span>
          Modifiers: Skier Type & Age
        </h2>
        <p class="text-sm text-mute leading-relaxed">
          The baseline code is adjusted based on skiing speed, aggression, and bone density age factors:
        </p>
        <ul class="text-xs space-y-2 text-ink font-mono mt-4">
          <li class="flex items-center justify-between p-3 rounded-lg bg-canvas border border-hairline">
            <span>Type -I (Extremely Cautious)</span>
            <span class="text-emerald-500 font-semibold">-1 Row Step</span>
          </li>
          <li class="flex items-center justify-between p-3 rounded-lg bg-canvas border border-hairline">
            <span>Type I (Cautious / Beginner)</span>
            <span class="text-mute">0 Steps (Baseline)</span>
          </li>
          <li class="flex items-center justify-between p-3 rounded-lg bg-canvas border border-hairline">
            <span>Type II (Moderate / All-Mountain)</span>
            <span class="text-primary font-semibold">+1 Row Step</span>
          </li>
          <li class="flex items-center justify-between p-3 rounded-lg bg-canvas border border-hairline">
            <span>Type III (Aggressive / Expert)</span>
            <span class="text-amber-500 font-semibold">+2 Row Steps</span>
          </li>
          <li class="flex items-center justify-between p-3 rounded-lg bg-canvas border border-hairline">
            <span>Age Modifier (&lt;10 or &ge;50 years)</span>
            <span class="text-emerald-500 font-semibold">-1 Row Step</span>
          </li>
        </ul>
      </div>

      <div class="p-8 rounded-[24px] bg-parchment border border-hairline space-y-4 md:col-span-2 shadow-sm">
        <h2 class="text-lg font-semibold text-ink flex items-center gap-3">
          <span class="w-8 h-8 rounded-full bg-canvas border border-hairline text-ink flex items-center justify-center text-sm font-semibold">3</span>
          Boot Sole Length (BSL) Lever Arm Physics
        </h2>
        <p class="text-sm text-mute leading-relaxed">
          Why does a longer boot have a lower DIN setting for the exact same skier? Ski bindings release based on <strong>rotational torque (Newton-meters)</strong>. A longer ski boot acts as a longer physical lever arm against the binding. Because Torque = Force &times; Distance, a longer boot produces greater leverage against binding lugs at lower force, requiring a lower DIN calibration number to release at the identical safe bone-stress threshold.
        </p>
      </div>

      {/* Primary Sources & Standard Citations */}
      <div class="p-8 rounded-[24px] bg-canvas border border-hairline space-y-4 md:col-span-2">
        <h2 class="text-base font-semibold text-ink">Standards & Primary Sources</h2>
        <ul class="text-xs text-mute space-y-2 leading-relaxed">
          <li>• <strong>ISO 11088:2023 (Edition 7):</strong> <em>Assembly, adjustment and inspection of an alpine ski-binding-boot (S-B-B) system</em> — International Organization for Standardization (<a href="https://www.iso.org/standard/83020.html" target="_blank" rel="noopener noreferrer" class="underline hover:text-primary">iso.org/standard/83020</a>).</li>
          <li>• <strong>ASTM F1063:</strong> <em>Standard Practice for Functional Inspections and Adjustments of Alpine Ski/Binding/Boot Systems</em> — American Society for Testing and Materials.</li>
          <li>• <strong>ISO 9462:</strong> <em>Alpine ski-bindings — Requirements and test methods</em>.</li>
        </ul>
        <div class="pt-4 border-t border-hairline text-xs text-mute">
          <strong>Important Safety Note:</strong> Visual indicator scale numbers on bindings are references for calibrated torque release. Binding adjustments, forward pressure checks, and mechanical verification must be performed by a certified ski workshop technician using a calibrated mechanical test device.
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
