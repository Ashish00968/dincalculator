---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MatrixTable } from '../calculator/MatrixTable';
import { useTranslations, getRouteFromUrl } from '../../i18n/utils';
import type { ui } from '../../i18n/ui';

interface Props {
  lang?: keyof typeof ui;
}

const { lang = (Astro.params.lang as keyof typeof ui) || 'en' } = Astro.props;
const t = useTranslations(lang);
const siteUrl = 'https://dincalculatorpro.com';

const pageTitle = t('page.matrix.title');
const pageDescription = t('page.matrix.desc');

