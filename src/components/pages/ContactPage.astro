---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, getRouteFromUrl } from '../../i18n/utils';
import type { ui } from '../../i18n/ui';

interface Props {
  lang?: keyof typeof ui;
}

const { lang = (Astro.params.lang as keyof typeof ui) || 'en' } = Astro.props;
const t = useTranslations(lang);
const siteUrl = 'https://dincalculatorpro.com';

const pageTitle = t('page.contact.title');
const pageDescription = t('page.contact.desc');

interface ContactTopic {
  icon: string;
  title: string;
  desc: string;
}

interface ContactContent {
  badge: string;
  h1Prefix: string;
  h1Highlight: string;
  subtitle: string;
  infoTitle: string;
  emailLabel: string;
  responseLabel: string;
  responseDesc: string;
  privacyLabel: string;
  privacyDesc: string;
  faqPrompt: string;
  formTitle: string;
  nameLabel: string;
  namePlaceholder: string;
  emailInputLabel: string;
  emailPlaceholder: string;
  subjectLabel: string;
  subjects: string[];
  messageLabel: string;
  messagePlaceholder: string;
  submitBtn: string;
  sendingText: string;
  deliveryNote: string;
  successTitle: string;
  successDesc1: string;
  successDesc2: string;
  resetBtn: string;
  errorTitle: string;
  errorMsgFallback: string;
  helpTitle: string;
  topics: ContactTopic[];
