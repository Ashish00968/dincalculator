---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculatorApp from '../calculator/CalculatorApp';
import FaqSection from '../ui/FaqSection.astro';
import { getRouteFromUrl, useTranslations } from '../../i18n/utils';
import type { ui } from '../../i18n/ui';
import { calculateDIN } from '../../engine/din-engine';

interface Props {
  lang?: keyof typeof ui;
}

const { lang = (Astro.params.lang as keyof typeof ui) || 'en' } = Astro.props;
const t = useTranslations(lang);
const siteUrl = 'https://dincalculatorpro.com';

const pageTitle = t('page.home.title');
const pageDescription = t('page.home.desc');

// Server-rendered build-time quick reference data derived from ISO 11088:2023 engine
const quickWeights = [
  { kg: 45, lbs: 99, ht: 155 },
  { kg: 55, lbs: 121, ht: 165 },
  { kg: 65, lbs: 143, ht: 172 },
  { kg: 75, lbs: 165, ht: 178 },
  { kg: 85, lbs: 187, ht: 184 },
  { kg: 95, lbs: 209, ht: 190 },
];

const quickTable = quickWeights.map(w => ({
  weight: `${w.kg} kg (${w.lbs} lbs)`,
  type1: calculateDIN({ weightKg: w.kg, heightCm: w.ht, age: 30, skierType: 'I', bslMm: 305 }).din,
  type2: calculateDIN({ weightKg: w.kg, heightCm: w.ht, age: 30, skierType: 'II', bslMm: 305 }).din,
  type3: calculateDIN({ weightKg: w.kg, heightCm: w.ht, age: 30, skierType: 'III', bslMm: 305 }).din,
}));

const workedExample = calculateDIN({
  weightKg: 75,
  heightCm: 178,
  age: 30,
  skierType: 'II',
  bslMm: 305,
});

const homeContent = {
  de: {
    quickAnswerBadge: 'Kurzübersicht & Referenzleitfaden',
    quickAnswerH2: 'Welchen Z-Wert benötigen Sie für Ihre Skibindung?',
    quickAnswerP: 'Der Z-Wert (DIN) steuert das Drehmoment, bei dem die Bindung im Sturzfall auslöst. Berechnet nach ISO 11088:2023 wird Ihr Fahrercode aus Gewicht und Körpergröße ermittelt, an Fahrertyp und Alter angepasst und mit der Sohlenlänge (BSL in mm) abgeglichen.',
    exampleTitle: 'Rechenbeispiel nach ISO 11088:2023',
    profile: 'Fahrerprofil:',
    profileVal: '75 kg, 178 cm, 30 Jahre, Typ II, BSL 305mm',
    step1: 'Schritt 1 — Gewichtscode (67–78 kg):',
    step2: 'Schritt 2 — Größencode (167–178 cm):',
    step3: 'Schritt 3 — Basis-Fahrercode:',
    step3Val: 'Code K (Übereinstimmung)',
    step4: 'Schritt 4 — Fahrertyp II Anpassung:',
    step4Val: '+1 Zeilensprung → Code L',
    step5: 'Schritt 5 — Altersanpassung (30 Jahre):',
    step5Val: '0 Modifikator (Erwachsener) → Code L',
    step6: 'Schritt 6 — Sohlenlänge 305 mm Abgleich:',
    note: 'Hinweis: Alle Berechnungen liefern einen Richtwert. Die endgültige Auslöseeinstellung muss von einem qualifizierten Skiservice auf einem kalibrierten Prüfgerät getestet werden.',
    tableTitle: 'Z-Wert Richtwerte nach Gewicht (BSL 305 mm, Erwachsene)',
    tableWeight: 'Körpergewicht',
    tableType1: 'Typ I (Anfänger)',
    tableType2: 'Typ II (All-Mtn)',
    tableType3: 'Typ III (Sportlich)',
    exploreMore: 'Alle Sohlenlängen und Fahrercodes erkunden:',
    fullMatrixLink: 'Vollständige ISO 11088 Tabelle →',
    pillars: [
      { title: "Basiert auf ISO 11088:2023", desc: "Vollständige Implementierung der aktuellen Norm inklusive Konfliktlösung zwischen Größe und Gewicht sowie Altersstufen." },
      { title: "Zero-Data Architektur", desc: "Sämtliche Berechnungen finden lokal im Browser-RAM statt. Keine Cookies, kein Tracking, keine Speicherung auf Servern." },
      { title: "Service-Exportkarte", desc: "Drucken Sie Ihre Einstellwerte als kompakte Werkstattkarte für die Überprüfung im zertifizierten Skiservice aus." }
    ],
    methodologyH2: "So funktioniert die Z-Wert-Berechnung (ISO 11088)",
    methodologyDesc: "Transparente, schrittweise Ermittlung Ihrer Skibindungsauslösung.",
    methodologySteps: [
      { step: "01", title: "Basis-Fahrercode", desc: "Körpergewicht und Größe bestimmen den initialen Fahrercode (A bis M)." },
      { step: "02", title: "Fahrertyp-Anpassung", desc: "Typ I bleibt auf der Basiszeile, Typ II rückt 1 Zeile nach unten (+1 Z-Wert), Typ III um 2 Zeilen." },
      { step: "03", title: "Altersfaktor", desc: "Skifahrer unter 10 oder ab 50 Jahren rücken 1 Zeile nach oben (niedrigerer Z-Wert) zum Gelenkschutz." },
      { step: "04", title: "Sohlenlänge-Abgleich", desc: "Der finale Fahrercode wird in der ISO-Matrix mit der Sohlenlänge (BSL in mm) am Skischuh verknüpft." }
    ],
    guideH2: "Wissenswertes zur Einstellung von Skibindungen",
    guideDesc: "Alles über Auslösewerte, ISO 11088 Konformität und die sichere Handhabung.",
    dinDefTitle: "Was bedeutet der Z-Wert (DIN-Einstellung)?",
    dinDefP1: "Der Z-Wert (abgeleitet von den Standards des Deutschen Instituts für Normung) ist eine kalibrierte Zahlenskala, die das Auslösemoment einer Skibindung definiert. Er bestimmt, welche Hebel- und Torsionskräfte auf den Schuh einwirken müssen, bevor die Bindung den Schuh im Sturzfall freigibt.",
    dinDefP2: "Die offizielle ISO 11088 Matrix umfasst Richtwerte von 0,75 bis 12,00. Einsteiger benötigen meist Werte zwischen 2 und 5, während sportliche Fahrer und Rennläufer Bindungen mit Werten bis 14, 16 oder höher nutzen. Ein zu niedrig eingestellter Z-Wert führt zu Fehlauslösungen während des Schwungs; ein zu hoher Wert verhindert das Auslösen bei Stürzen und steigert das Verletzungsrisiko.",
    isoMattersTitle: "Warum die Norm ISO 11088:2023 entscheidend ist",
    isoMattersP1: "ISO 11088 ist die maßgebliche internationale Norm für Montage, Einstellung und Überprüfung der Funktionseinheit Ski-Bindung-Schuh. Sie legt den mathematischen Zusammenhang zwischen den biometrischen Daten des Fahrers — Gewicht, Größe, Alter und Sohlenlänge — und dem sicheren Auslösemoment fest.",
    isoMattersP2: "DIN Calculator Pro basiert auf der aktuellen Ausgabe ISO 11088:2023 (Edition 7, welche die zurückgezogene Version von 2018 ersetzt). Jede Berechnung folgt den standardisierten Tabellen, Zeilensprüngen für den Fahrertyp und Alterskorrekturen der Norm.",
    fourStepTitle: "Die 4-Schritte-Methode nach ISO 11088",
    fourStep1Title: "Basis-Fahrercode ermitteln.",
    fourStep1Desc: "Körpergewicht und Körpergröße ergeben einen initialen Buchstaben (A bis M). Bei abweichenden Zeilen schreibt ISO 11088 aus Sicherheitsgründen die Wahl der oberen Zeile (niedrigerer Buchstabe) vor.",
    fourStep2Title: "Fahrertyp-Korrektur anwenden.",
    fourStep2Desc: "Typ I nutzt die Basiszeile. Typ II rückt 1 Zeile tiefer (+1 Buchstabe, höherer Z-Wert). Typ III rückt 2 Zeilen tiefer (+2 Buchstaben). Typ III+ rückt 3 Zeilen tiefer. Typ −I rückt 1 Zeile nach oben (-1 Buchstabe für Fahrer ab 17 kg). Fahrer bis 13 kg erhalten keinen Modifikator.",
    fourStep3Title: "Alterskorrektur anwenden.",
    fourStep3Desc: "Skifahrer unter 10 Jahren oder ab 50 Jahren rücken 1 Zeile nach oben (-1 Buchstabe / niedrigerer Z-Wert), um Knochen und Bänder vor Überlastung zu schützen.",
    fourStep4Title: "Abgleich mit der Sohlenlänge (BSL).",
    fourStep4Desc: "Der finale Fahrercode bestimmt die Zeile in der ISO 11088 Tabelle; Ihre Sohlenlänge (BSL in mm) wählt die Spalte. Der Schnittpunkt liefert den Richtwert für den Z-Wert.",
    bslTitle: "Was ist die Sohlenlänge (BSL in mm)?",
    bslP1: "Die Sohlenlänge (Boot Sole Length, BSL) ist das exakte Außenmaß der Skischuhsohle in Millimetern von der Ferse bis zur Spitze. Sie ist dauerhaft seitlich oder an der Unterseite der Fersenbacke eingeprägt. BSL unterscheidet sich grundlegend von der Mondopoint-Größe (Fußlänge in cm): Schuhe gleicher Mondogröße 27,5 können je nach Schalenmodell zwischen 298 mm und 320 mm variieren.",
    bslP2: "Die Sohlenlänge beeinflusst den Z-Wert direkt, da ein längerer Schuh eine größere Hebelwirkung auf die Bindung ausübt. Verwenden Sie stets den eingeprägten Millimeterwert — niemals die Schuhgröße schätzen.",
    bslLinkText: "Leitfaden zur Sohlenlänge & Mondopoint →",
    skierTypeTitle: "Auswahl Ihres Fahrertyps",
    skierTypeP1: "Die korrekte Einstufung des Fahrertyps ist essenziell — Fehleinschätzungen sind die häufigste Ursache für falsch eingestellte Skibindungen. Die Norm ISO 11088 definiert vier Kategorien:",
    skierTypeMinusI: "Extrem vorsichtige Fahranfänger und Kinder, die nur auf sanften Hängen mit sehr geringem Tempo fahren.",
    skierTypeI: "Vorsichtige Fahrer auf einfachen Pisten bei mäßigem Tempo. Frühe Auslösung zum Schutz der Gelenke hat oberste Priorität.",
    skierTypeII: "Fortgeschrittene All-Mountain-Fahrer auf abwechslungsreichem Terrain bei zügigem Tempo. Der Standard für die Mehrheit der Erwachsenen.",
    skierTypeIII: "Sehr sportliche, aggressive Skifahrer in steilem Gelände bei hoher Geschwindigkeit. Erhöhter Halt zur Vermeidung von Fehlauslösungen.",
    skierTypeP2: "Die meisten erwachsenen Hobbyskifahrer fallen unter Typ I oder Typ II. Eine ungerechtfertigte Selbsteinstufung als Typ III führt zu gefährlich hohen Auslösewerten.",
    safetyTitle: "Kann ein Online-Rechner den Skiservice ersetzen?",
    safetyP1: "DIN Calculator Pro liefert eine fundierte mathematische Referenz auf Basis von ISO 11088:2023. Dies ist ein präziser Ausgangswert, ersetzt jedoch keinesfalls die fachmännische Inspektion in der Werkstatt. Die mechanische Bindungseinstellung, der Anpressdruck und die Reibung müssen stets von einem qualifizierten Skiservice auf einem geeichten Drehmoment-Prüfgerät überprüft werden.",
    safetyP2: "Die tatsächliche Auslösung wird durch Faktoren beeinflusst, die keine Software erfassen kann: Abnutzung der Sohlen an Spitze und Ferse, Gleitplattenreibung (AFD), Federvorspannung und Alterung der Mechanik. Nur ein mechanischer Drehmomentprüfstand misst das echte Auslösemoment verlässlich.",
    safetyWorkflowTitle: "Empfohlener Ablauf:",
    safetyWorkflowText: "Ermitteln Sie Ihren Z-Wert mit DIN Calculator Pro, drucken Sie Ihre persönliche Einstellungskarte aus und bringen Sie Ski und Schuhe zu einem Fachbetrieb. Dort wird der Z-Wert eingestellt, der Anpressdruck justiert und die Bindung nach ISO 11088 und ASTM F1063 geprüft.",
    subLinksMatrixTitle: "ISO 11088 Tabelle",
    subLinksMatrixDesc: "Vollständige Z-Wert Matrix",
    subLinksBslTitle: "Sohlenlänge BSL",
    subLinksBslDesc: "Sohlenmaß in mm finden",
    subLinksSkierTypesTitle: "Fahrertypen",
    subLinksSkierTypesDesc: "Leitfaden Typ I, II, III"
  },
  fr: {
    quickAnswerBadge: 'Réponse Rapide & Guide de Référence',
    quickAnswerH2: 'Quel réglage DIN pour vos fixations de ski ?',
    quickAnswerP: 'Le réglage DIN contrôle le couple nécessaire pour libérer la chaussure lors d\'une chute. Calculé selon l\'ISO 11088:2023, votre code skieur de base dépend de votre poids et taille, ajusté selon le profil de skieur et l\'âge, puis croisé avec la semelle (BSL en mm).',
    exampleTitle: 'Exemple de calcul pas à pas (ISO 11088:2023)',
    profile: 'Profil du skieur :',
    profileVal: '75 kg, 178 cm, 30 ans, Type II, BSL 305mm',
    step1: 'Étape 1 — Code poids (67–78 kg) :',
    step2: 'Étape 2 — Code taille (167–178 cm) :',
    step3: 'Étape 3 — Code de base :',
    step3Val: 'Code K (Concordance)',
    step4: 'Étape 4 — Modificateur Type II :',
    step4Val: '+1 ligne → Code L',
    step5: 'Étape 5 — Modificateur âge (30 ans) :',
    step5Val: '0 modificateur (Adulte) → Code L',
    step6: 'Étape 6 — Longueur semelle 305 mm :',
    note: 'Note : Les calculs fournissent une valeur indicative. Le réglage final et le déclenchement doivent être vérifiés sur banc de test calibré par un technicien ski agréé.',
    tableTitle: 'Valeurs DIN indicatives par poids (BSL 305 mm, Adulte)',
    tableWeight: 'Poids du skieur',
    tableType1: 'Type I (Débutant)',
    tableType2: 'Type II (Polyvalent)',
    tableType3: 'Type III (Sportif)',
    exploreMore: 'Explorer toutes les longueurs de semelles et codes :',
    fullMatrixLink: 'Grille Complète ISO 11088 →',
    pillars: [
      { title: "Conforme ISO 11088:2023", desc: "Intègre la matrice complète avec arbitrage poids-taille, corrections d'âge et modificateurs de profil de ski." },
      { title: "Architecture Sans Données", desc: "Tous les calculs s'exécutent localement dans votre navigateur. Aucun cookie, aucun traceur, zéro donnée stockée." },
      { title: "Fiche Atelier Imprimable", desc: "Exportez une fiche récapitulative propre à présenter à votre technicien ski pour le réglage et le test en atelier." }
    ],
    methodologyH2: "Méthode de calcul DIN selon ISO 11088",
    methodologyDesc: "Comprendre étape par étape le réglage de déclenchement de vos fixations.",
    methodologySteps: [
      { step: "01", title: "Code de base", desc: "Le poids et la taille définissent votre lettre skieur initiale (de A à M)." },
      { step: "02", title: "Niveau de ski", desc: "Le Type I conserve la ligne de base, le Type II descend d'une ligne (+1 DIN), le Type III de 2 lignes." },
      { step: "03", title: "Facteur âge", desc: "Les skieurs de moins de 10 ans ou de 50 ans et plus remontent d'une ligne pour préserver les articulations." },
      { step: "04", title: "Croisement semelle", desc: "La ligne finale croise la colonne correspondant à la longueur de semelle en mm gravée sur la chaussure." }
    ],
    guideH2: "Comprendre le réglage de vos fixations de ski",
    guideDesc: "Tout savoir sur les normes de déclenchement, l'ISO 11088 et la sécurité sur les pistes.",
    dinDefTitle: "Qu'est-ce qu'un réglage DIN pour fixations de ski ?",
    dinDefP1: "Le réglage DIN (du nom du Deutsches Institut für Normung) est une valeur numérique étalonnée qui définit le couple de déclenchement d'une fixation de ski alpin. Il détermine la force de torsion ou de basculement nécessaire pour libérer la chaussure lors d'une chute.",
    dinDefP2: "La grille officielle ISO 11088 définit des valeurs indicatives de 0,75 à 12,00. Les débutants se situent généralement entre 2 et 5, tandis que les compétiteurs et freeriders experts utilisent des fixations montant à 14, 16 ou plus. Un DIN trop bas provoque des décrochages intempestifs en virage ; un DIN trop haut empêche le déclenchement en cas de chute et accroît le risque d'entorse grave ou de fracture.",
    isoMattersTitle: "Pourquoi la norme ISO 11088:2023 est essentielle",
    isoMattersP1: "La norme internationale ISO 11088 régit l'assemblage, l'ajustement et le contrôle de l'ensemble ski-fixation-chaussure. Elle établit la corrélation mathématique entre le profil biométrique du skieur — poids, taille, âge et longueur de semelle — et le couple de déclenchement approprié.",
    isoMattersP2: "DIN Calculator Pro applique l'édition 7 de la norme ISO 11088:2023 (qui remplace l'ancienne édition 2018). Chaque calcul est strictement dérivé des barèmes officiels, intégrant les décalages de lignes par profil et les corrections d'âge.",
    fourStepTitle: "La méthode de calcul ISO 11088 en 4 étapes",
    fourStep1Title: "Déterminer la lettre skieur initiale.",
    fourStep1Desc: "Le poids et la taille déterminent une lettre de base (de A à M). En cas de désaccord entre les deux critères, la norme ISO prescrit de choisir la ligne la plus haute du tableau (lettre inférieure) par mesure de sécurité.",
    fourStep2Title: "Appliquer le modificateur de profil de ski.",
    fourStep2Desc: "Le Type I utilise la ligne de base. Le Type II descend d'une ligne (+1 lettre, DIN supérieur). Le Type III descend de 2 lignes (+2 lettres). Le Type III+ descend de 3 lignes. Le Type −I remonte d'une ligne (-1 lettre pour les skieurs de plus de 17 kg). Les skieurs de 13 kg ou moins ne reçoivent aucun ajustement.",
    fourStep3Title: "Appliquer la correction liée à l'âge.",
    fourStep3Desc: "Les skieurs de moins de 10 ans ou de 50 ans et plus remontent d'une ligne sur le barème (-1 lettre / DIN inférieur) pour protéger les articulations et la structure osseuse.",
    fourStep4Title: "Croiser avec la longueur de semelle (BSL en mm).",
    fourStep4Desc: "Votre lettre définitive détermine la ligne de la matrice ISO 11088 ; la longueur de semelle de votre chaussure sélectionne la colonne. La cellule d'intersection donne votre réglage DIN indicatif.",
    bslTitle: "Qu'est-ce que la longueur de semelle (BSL) ?",
    bslP1: "La longueur de semelle (Boot Sole Length ou BSL) correspond à la longueur extérieure totale de la coque en millimètres, de la butée avant à la talonnière. Elle est gravée sur le talon ou le flanc de chaque chaussure de ski alpin. La BSL est différente de la taille Mondopoint (longueur du pied en cm) : deux chaussures de pointure 27.5 peuvent avoir des semelles de 298 mm à 320 mm.",
    bslP2: "La longueur de semelle modifie directement le couple nécessaire : une semelle plus longue produit un bras de levier plus important sur la fixation. Utilisez toujours la valeur en millimètres gravée sur la chaussure — ne déduisez jamais la semelle de votre pointure de ville.",
    bslLinkText: "Guide de la longueur de semelle & Mondopoint →",
    skierTypeTitle: "Choisir votre profil de skieur",
    skierTypeP1: "Bien identifier son profil est crucial : une auto-évaluation inexacte est la cause la plus fréquente d'erreur de réglage. La norme ISO 11088 définit quatre profils :",
    skierTypeMinusI: "Skieurs très prudents et jeunes enfants skiant uniquement sur pentes douces à très faible allure.",
    skierTypeI: "Skieurs prudents évoluant à vitesse modérée sur pistes faciles. La sécurité et le déclenchement immédiat sont prioritaires.",
    skierTypeII: "Skieurs réguliers et polyvalents skiant à allure moyenne à rapide sur terrains variés. Concerne la majorité des adultes.",
    skierTypeIII: "Skieurs experts et agressifs engagés dans des pentes raides à grande vitesse. La rétention de la chaussure est prioritaire.",
    skierTypeP2: "La majorité des skieurs adultes récréatifs correspondent au Type I ou Type II. Se surclasser en Type III sans en avoir le niveau expose à un risque majeur de non-déclenchement.",
