---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculatorApp from '../calculator/CalculatorApp';
import FaqSection from '../ui/FaqSection.astro';
import { getRouteFromUrl, useTranslations } from '../../i18n/utils';
import type { ui } from '../../i18n/ui';
import { calculateDIN } from '../../engine/din-engine';

interface Props {
  lang?: keyof typeof ui;
}

const { lang = (Astro.params.lang as keyof typeof ui) || 'en' } = Astro.props;
const t = useTranslations(lang);
const siteUrl = 'https://dincalculatorpro.com';

const pageTitle = t('page.home.title');
const pageDescription = t('page.home.desc');

// Server-rendered build-time quick reference data derived from ISO 11088:2023 engine
const quickWeights = [
  { kg: 45, lbs: 99, ht: 155 },
  { kg: 55, lbs: 121, ht: 165 },
  { kg: 65, lbs: 143, ht: 172 },
  { kg: 75, lbs: 165, ht: 178 },
  { kg: 85, lbs: 187, ht: 184 },
  { kg: 95, lbs: 209, ht: 190 },
];

const quickTable = quickWeights.map(w => ({
  weight: `${w.kg} kg (${w.lbs} lbs)`,
  type1: calculateDIN({ weightKg: w.kg, heightCm: w.ht, age: 30, skierType: 'I', bslMm: 305 }).din,
  type2: calculateDIN({ weightKg: w.kg, heightCm: w.ht, age: 30, skierType: 'II', bslMm: 305 }).din,
  type3: calculateDIN({ weightKg: w.kg, heightCm: w.ht, age: 30, skierType: 'III', bslMm: 305 }).din,
}));

const workedExample = calculateDIN({
  weightKg: 75,
  heightCm: 178,
  age: 30,
  skierType: 'II',
  bslMm: 305,
});
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <!-- HERO — Keyword-focused H1 & Value Proposition -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.04]" style="background-image: linear-gradient(var(--theme-hairline) 1px, transparent 1px), linear-gradient(90deg, var(--theme-hairline) 1px, transparent 1px); background-size: 48px 48px;"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[500px] h-[200px] rounded-full opacity-10 dark:opacity-[0.05] blur-3xl" style="background: radial-gradient(circle, #FF6B00 0%, transparent 70%);"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-8 sm:pt-16 sm:pb-10 text-center">
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold text-ink tracking-tight leading-[1.1] mb-3">
        {lang === 'de' ? 'Z-Wert Rechner Skibindung' : lang === 'fr' ? 'Calculateur DIN Fixations de Ski' : lang === 'it' ? 'Calcolatore DIN Attacchi Sci' : 'Ski DIN Calculator'}
      </h1>
      <p class="text-sm sm:text-base text-mute max-w-2xl mx-auto mb-6 leading-relaxed">
        {lang === 'de' 
          ? 'Kostenloser Skibindungs-Rechner nach ISO 11088:2023. Ermitteln Sie Ihren Richtwert transparent in wenigen Sekunden.' 
          : lang === 'fr' 
          ? 'Calculateur de réglage DIN pour fixations de ski selon ISO 11088:2023. Gratuit, instantané et transparent.' 
          : lang === 'it' 
          ? 'Calcolo taratura attacchi da sci secondo la norma ISO 11088:2023. Gratuito, trasparente e immediato.' 
          : 'Free ski binding release calculator based on ISO 11088:2023 (Edition 7). Calculate your recommended DIN setting in seconds.'}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 mb-5">
        <a href="#calculator" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-primary text-white font-semibold text-sm transition-all hover:opacity-90 hover:scale-[1.02] shadow-lg" style="box-shadow: 0 4px 24px -4px color-mix(in srgb, var(--theme-primary) 50%, transparent);">
          {t('cta.calcMyDin')}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href={getRouteFromUrl(new URL('/din-chart/', siteUrl), lang)} class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-hairline bg-parchment text-ink font-medium text-sm transition-all hover:border-primary/50 hover:bg-canvas">
          {t('cta.matrixTable')}
        </a>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1.5 text-xs text-mute">
        <span class="flex items-center gap-1.5"><svg class="w-3 h-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Based on ISO 11088:2023</span>
        <span class="flex items-center gap-1.5"><svg class="w-3 h-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Cookieless & Private</span>
        <span class="flex items-center gap-1.5"><svg class="w-3 h-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Free & Open-Source</span>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       CALCULATOR SECTION
  ══════════════════════════════════════════════ -->
  <section id="calculator" class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <!-- Divider label -->
    <div class="flex items-center gap-4 mb-8">
      <div class="h-px flex-1 bg-hairline"></div>
      <span class="text-[11px] font-mono font-semibold text-mute uppercase tracking-widest px-3">Calculator</span>
      <div class="h-px flex-1 bg-hairline"></div>
    </div>

    <CalculatorApp client:load lang={lang} />

    <!-- Trust Strip -->
    <div class="mt-6 p-4 rounded-xl bg-parchment border border-hairline flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-mute">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Based on <strong>ISO 11088:2023</strong> (Edition 7) · Engine v2.0.0 · Independent project</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/methodology/" class="text-primary hover:underline font-medium">Methodology & Limitations →</a>
        <a href="/changelog/" class="text-primary hover:underline font-medium">Changelog →</a>
      </div>
    </div>

    <!-- ANSWER-FIRST BLOCK — Crawlable answers & worked example (ISO 11088:2023) -->
    <div class="mt-10 p-6 sm:p-8 rounded-2xl bg-canvas border border-hairline shadow-sm space-y-6">
      <div class="border-b border-hairline pb-4">
        <div class="flex items-center gap-2 text-xs font-mono text-accent uppercase tracking-wider mb-1">
          <span>Quick Answer & Reference Guide</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-ink">
          What DIN Setting Do You Need?
        </h2>
        <p class="text-sm text-mute leading-relaxed mt-2">
          A ski binding DIN setting controls the force required to release your boot safely during a fall. Calculated under ISO 11088:2023, your baseline code is determined by your weight and height, adjusted for skier type (-I to III+) and age group, and finally mapped against your boot sole length (BSL in mm).
        </p>
      </div>

      <!-- Worked Example & Quick Table Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Worked Example Breakdown -->
        <div class="lg:col-span-6 space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold text-ink">Worked Calculation Example</h3>
            <span class="text-xs font-mono text-mute">ISO 11088:2023</span>
          </div>
          <div class="p-4 rounded-xl bg-parchment border border-hairline space-y-3 text-xs">
            <div class="flex justify-between py-1 border-b border-hairline/60">
              <span class="text-mute">Skier Profile:</span>
              <span class="font-mono font-medium text-ink">75 kg (165 lbs), 178 cm, 30 yrs, Type II, BSL 305mm</span>
            </div>
            <div class="flex justify-between py-1 border-b border-hairline/60">
              <span class="text-mute">Step 1 — Weight Code (67–78 kg):</span>
              <span class="font-mono font-semibold text-ink">Code K</span>
            </div>
            <div class="flex justify-between py-1 border-b border-hairline/60">
              <span class="text-mute">Step 2 — Height Code (167–178 cm):</span>
              <span class="font-mono font-semibold text-ink">Code K</span>
            </div>
            <div class="flex justify-between py-1 border-b border-hairline/60">
              <span class="text-mute">Step 3 — Baseline Determination:</span>
              <span class="font-mono font-semibold text-ink">Code K (Agreement)</span>
            </div>
            <div class="flex justify-between py-1 border-b border-hairline/60">
              <span class="text-mute">Step 4 — Skier Type II Shift:</span>
              <span class="font-mono font-semibold text-accent">+1 Row Shift → Code L</span>
            </div>
            <div class="flex justify-between py-1 border-b border-hairline/60">
              <span class="text-mute">Step 5 — Age Modifier (30 years):</span>
              <span class="font-mono text-ink">0 Modifier (Adult) → Final Code L</span>
            </div>
            <div class="flex justify-between items-center pt-1 text-sm font-bold text-ink">
              <span>Step 6 — BSL 305 mm Lookup:</span>
              <span class="text-primary font-mono text-base px-2.5 py-0.5 rounded bg-primary/10 border border-primary/20">DIN {workedExample.din}</span>
            </div>
          </div>
          <p class="text-[11px] text-mute italic">
            Note: All calculations provide a baseline setting. Final release calibration must be verified on diagnostic test equipment by a certified ski technician.
          </p>
        </div>

        <!-- Quick Reference by Weight Table -->
        <div class="lg:col-span-6 space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold text-ink">Baseline DIN by Weight (BSL 305 mm, Adult)</h3>
            <span class="text-xs font-mono text-mute">BSL 291–310 mm</span>
          </div>
          <div class="overflow-x-auto rounded-xl border border-hairline bg-parchment">
            <table class="w-full text-xs text-left">
              <thead class="bg-input/70 border-b border-hairline text-mute font-mono">
                <tr>
                  <th class="px-3 py-2">Skier Weight</th>
                  <th class="px-3 py-2 text-center">Type I (Beginner)</th>
                  <th class="px-3 py-2 text-center font-semibold text-ink">Type II (All-Mtn)</th>
                  <th class="px-3 py-2 text-center">Type III (Aggressive)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline font-mono">
                {quickTable.map((row) => (
                  <tr class="hover:bg-canvas/50 transition-colors">
                    <td class="px-3 py-2 text-ink font-medium">{row.weight}</td>
                    <td class="px-3 py-2 text-center text-mute">{row.type1}</td>
                    <td class="px-3 py-2 text-center font-bold text-primary">{row.type2}</td>
                    <td class="px-3 py-2 text-center text-ink">{row.type3}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="flex items-center justify-between text-[11px] text-mute">
            <span>Explore all boot sole lengths and skier codes:</span>
            <a href="/din-chart/" class="text-primary hover:underline font-medium">Full ISO 11088 Matrix →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       FEATURE PILLARS — 3-up grid
  ══════════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 pt-4">
    <div class="flex items-center gap-4 mb-12">
      <div class="h-px flex-1 bg-hairline"></div>
      <h2 class="text-[11px] font-mono font-semibold text-mute uppercase tracking-widest px-3">System Architecture & Standards</h2>
      <div class="h-px flex-1 bg-hairline"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">

      <div class="group p-7 rounded-2xl bg-parchment border border-hairline hover:border-primary/30 transition-all hover:shadow-md space-y-4">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center text-primary" style="background: color-mix(in srgb, var(--theme-primary) 12%, transparent);">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <div>
          <h3 class="font-semibold text-ink mb-2">Based on ISO 11088:2023</h3>
          <p class="text-sm text-mute leading-relaxed">Implements the full ISO 11088:2023 matrix including height-weight conflict resolution, age modifiers, and horizontal nearest-neighbor fallback logic.</p>
        </div>
      </div>

      <div class="group p-7 rounded-2xl bg-parchment border border-hairline hover:border-emerald-500/30 transition-all hover:shadow-md space-y-4">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-500">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        </div>
        <div>
          <h3 class="font-semibold text-ink mb-2">Zero-Data Architecture</h3>
          <p class="text-sm text-mute leading-relaxed">All calculations run in browser RAM. Your weight, height, age, and boot size are never sent to a server, stored in cookies, or logged anywhere.</p>
        </div>
      </div>

      <div class="group p-7 rounded-2xl bg-parchment border border-hairline hover:border-cyan-500/30 transition-all hover:shadow-md space-y-4">
        <div class="w-10 h-10 rounded-xl bg-cyan-500/10 flex items-center justify-center text-cyan-500">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <div>
          <h3 class="font-semibold text-ink mb-2">Technician Export Card</h3>
          <p class="text-sm text-mute leading-relaxed">Export a clean, printable summary card with your DIN settings to share with a certified ski technician for binding mounting and calibration.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       HOW IT WORKS — 4-step methodology
  ══════════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-hairline">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-[11px] uppercase tracking-widest font-semibold text-mute mb-3 block font-mono">Methodology</span>
      <h2 class="text-3xl sm:text-4xl font-bold text-ink tracking-tight">How the ISO 11088 math works.</h2>
      <p class="text-mute mt-4 text-sm sm:text-base">A transparent, step-by-step breakdown of how your DIN value is calculated.</p>
    </div>

    <div class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">

      {[
        {
          step: "01",
          title: "Baseline Force",
          desc: "Body weight and height determine your initial Skier Code and safe threshold.",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m0-18l8 6M12 3L4 9"/>`
        },
        {
          step: "02",
          title: "Ability Shift",
          desc: "Your Skier Type modifies the code: Type I uses the baseline row, Type II moves 1 row lower on the chart, Type III moves 2 rows lower.",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>`
        },
        {
          step: "03",
          title: "Age Modifier",
          desc: "Skiers under 10 or age 50+ move 1 row higher on the chart (lower DIN) for bone and joint safety.",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>`
        },
        {
          step: "04",
          title: "Matrix Lookup",
          desc: "Your final Skier Code intersects with your Boot Sole Length on the ISO 11088:2023 matrix.",
          icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>`
        }
      ].map((item) => (
        <div class="bg-parchment border border-hairline p-6 rounded-2xl text-center flex flex-col items-center group hover:border-primary/40 transition-all hover:shadow-md">
          <span class="text-[11px] font-mono font-bold text-primary/70 mb-3 tracking-widest">{item.step}</span>
          <div class="w-11 h-11 rounded-2xl bg-canvas border border-hairline flex items-center justify-center text-primary mb-4 group-hover:border-primary/40 group-hover:bg-primary/5 transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" set:html={item.icon}></svg>
          </div>
          <h3 class="font-semibold text-ink mb-2 text-[15px]">{item.title}</h3>
          <p class="text-xs text-mute leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       SEO LONG-FORM CONTENT — ~1000 words
  ══════════════════════════════════════════════ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-hairline">
    <div class="prose-section space-y-10">

      <div class="text-center mb-12">
        <span class="text-[11px] uppercase tracking-widest font-semibold text-mute mb-3 block font-mono">Complete Guide</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-ink tracking-tight">Understanding Your Ski Binding DIN Setting</h2>
        <p class="text-mute mt-4 max-w-2xl mx-auto text-sm sm:text-base leading-relaxed">Everything you need to know about ski binding release settings, ISO 11088 compliance, and how to use a DIN calculator safely.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <h3 class="text-xl font-bold text-ink">What Is a DIN Setting?</h3>
          <p class="text-mute text-sm leading-relaxed">
            A DIN setting (named after <em>Deutsches Institut für Normung</em>, the German Institute for Standardization) is a calibrated numeric value that defines the release torque of your alpine ski binding. It determines how much twisting or bending force must be applied to your boot before the binding releases it from the ski.
          </p>
          <p class="text-mute text-sm leading-relaxed">
            The standard ISO 11088 lookup matrix defines release values ranging from <strong class="text-ink">0.75 to 12.00</strong>. Recreational beginner skiers typically need settings between 2 and 5, while adult competition and freeride bindings scale beyond this table to 14, 16, or higher. Setting your DIN too low risks accidental pre-release during turns; setting it too high prevents release during a crash, increasing injury risk.
          </p>
        </div>

        <div class="space-y-4">
          <h3 class="text-xl font-bold text-ink">Why ISO 11088:2023 Matters</h3>
          <p class="text-mute text-sm leading-relaxed">
            ISO 11088 is the international standard that governs how alpine ski bindings are assembled, inspected, and adjusted. It defines the mathematical relationship between a skier's physical characteristics — weight, height, age, and boot sole length — and the appropriate release setting.
          </p>
          <p class="text-mute text-sm leading-relaxed">
            DIN Calculator Pro implements ISO 11088:2023 (Edition 7, which supersedes the withdrawn 2018 edition). Every calculation is derived from standard weight-height lookup tables, modified by exact skier type row offsets and age adjustments defined in the standard.
          </p>
        </div>
      </div>

      <div class="p-6 rounded-2xl bg-parchment border border-hairline space-y-4">
        <h3 class="text-xl font-bold text-ink">The Four-Step ISO 11088 Calculation Method</h3>
        <ol class="space-y-3 text-sm text-mute">
          <li class="flex gap-3">
            <span class="w-6 h-6 rounded-full bg-primary/10 text-primary font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">1</span>
            <div><strong class="text-ink">Determine your initial Skier Code.</strong> Body weight and height produce an initial Skier Code (A through M). Where height and weight suggest different codes, the ISO standard mandates selecting the row closer to the top of the chart (lower code) for conservative safety.</div>
          </li>
          <li class="flex gap-3">
            <span class="w-6 h-6 rounded-full bg-primary/10 text-primary font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">2</span>
            <div><strong class="text-ink">Apply the Skier Type modifier.</strong> Type I uses the baseline row. Type II moves one row lower on the chart (+1 code, higher DIN). Type III moves two rows lower (+2 codes). Type III+ moves three rows lower (+3 codes, manufacturer convention). Type −I moves one row higher (-1 code, for skiers over 17 kg). Skiers weighing 13 kg or less receive no ability modifier.</div>
          </li>
          <li class="flex gap-3">
            <span class="w-6 h-6 rounded-full bg-primary/10 text-primary font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">3</span>
            <div><strong class="text-ink">Apply the age modifier.</strong> Skiers under 10 years old or 50 and older move one row higher on the chart (-1 code reduction) to account for bone and joint vulnerability. Skiers weighing 13 kg or less receive no age modifier.</div>
          </li>
          <li class="flex gap-3">
            <span class="w-6 h-6 rounded-full bg-primary/10 text-primary font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">4</span>
            <div><strong class="text-ink">Cross-reference with Boot Sole Length (BSL).</strong> Your final adjusted Skier Code selects the row in the ISO 11088 matrix; your Boot Sole Length (BSL in mm) selects the column. The intersecting cell is your baseline DIN estimate.</div>
          </li>
        </ol>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <h3 class="text-xl font-bold text-ink">What Is Boot Sole Length (BSL)?</h3>
          <p class="text-mute text-sm leading-relaxed">
            Boot Sole Length (BSL) is the total length of the ski boot's sole in millimeters, measured from heel lug to toe lug. It is permanently stamped or embossed on the heel lug or arch of every alpine ski boot shell. BSL is entirely different from Mondo sizing (your foot length in centimeters) — a size 27.5 Mondo boot from different manufacturers can have BSL values ranging from 298 mm to 320 mm.
          </p>
          <p class="text-mute text-sm leading-relaxed">
            BSL directly affects DIN because longer boots apply more leverage to the binding. A binding that correctly releases a 300 mm BSL boot may pre-release a 330 mm boot under the same force, or fail to release a 290 mm boot in a crash. Always use the exact stamped BSL value — never estimate from shoe size.
          </p>
          <p class="text-mute text-sm leading-relaxed">
            Use our <a href={getRouteFromUrl(new URL('/bsl-guide/', siteUrl), lang)} class="text-primary hover:underline font-medium">BSL & Mondo Sizing Guide →</a> for a comprehensive lookup table and visual guide to locating the BSL stamp on your boot.
          </p>
        </div>

        <div class="space-y-4">
          <h3 class="text-xl font-bold text-ink">Choosing Your Skier Type</h3>
          <p class="text-mute text-sm leading-relaxed">
            Selecting the correct Skier Type is critical — it is the most common error when people set their own DIN incorrectly. The ISO 11088 standard defines four categories:
          </p>
          <ul class="space-y-2 text-sm text-mute">
            <li class="flex gap-2"><span class="text-primary font-semibold shrink-0">Type −I</span> Extremely cautious beginner children who ski only gentle, groomed terrain at very slow speeds.</li>
            <li class="flex gap-2"><span class="text-primary font-semibold shrink-0">Type I</span> Cautious skiers who ski at moderate speeds on easier groomed runs. Prefer easy release above all else.</li>
            <li class="flex gap-2"><span class="text-primary font-semibold shrink-0">Type II</span> Average skiers who ski varied terrain at moderate-to-high speeds. The default for most adults.</li>
            <li class="flex gap-2"><span class="text-primary font-semibold shrink-0">Type III</span> Aggressive, experienced skiers skiing difficult terrain at high speeds. Retention is prioritized over release.</li>
          </ul>
          <p class="text-mute text-sm leading-relaxed">Most recreational adult skiers are Type I or Type II. Self-classifying as Type III when you are not leads to dangerous over-retention settings.</p>
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="text-xl font-bold text-ink">Is a DIN Calculator Safe to Use Without a Technician?</h3>
        <p class="text-mute text-sm leading-relaxed">
          DIN Calculator Pro provides the precise mathematical baseline recommended by ISO 11088 — the same number a certified ski technician derives from the same lookup tables. However, the physical act of adjusting your binding and verifying its release force must always be performed by a certified ski technician using calibrated torque test equipment.
        </p>
        <p class="text-mute text-sm leading-relaxed">
          Binding release is affected by many physical factors beyond the ISO 11088 formula: boot wear at the toe and heel lugs, friction strip condition, forward pressure setting, binding model mechanical tolerances, and pivot point alignment. A torque test device measures the actual release force and allows fine-tuning that no calculator can provide.
        </p>
        <p class="text-mute text-sm leading-relaxed">
          <strong class="text-ink">The correct workflow:</strong> Use DIN Calculator Pro to determine your target DIN value, print or screenshot your result card, and bring it to a certified ski shop as a cross-reference. The technician will set, test, and certify your actual binding release within ±10% of the ISO standard value using their calibrated equipment.
        </p>
      </div>

