---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculatorApp from '../calculator/CalculatorApp';
import FaqSection from '../ui/FaqSection.astro';
import { getRouteFromUrl, useTranslations } from '../../i18n/utils';
import type { ui } from '../../i18n/ui';
import { calculateDIN } from '../../engine/din-engine';

interface Props {
  lang?: keyof typeof ui;
}

const { lang = (Astro.params.lang as keyof typeof ui) || 'en' } = Astro.props;
const t = useTranslations(lang);
const siteUrl = 'https://dincalculatorpro.com';

const pageTitle = t('page.home.title');
const pageDescription = t('page.home.desc');

// Server-rendered build-time quick reference data derived from ISO 11088:2023 engine
const quickWeights = [
  { kg: 45, lbs: 99, ht: 155 },
  { kg: 55, lbs: 121, ht: 165 },
  { kg: 65, lbs: 143, ht: 172 },
  { kg: 75, lbs: 165, ht: 178 },
  { kg: 85, lbs: 187, ht: 184 },
  { kg: 95, lbs: 209, ht: 190 },
];

const quickTable = quickWeights.map(w => ({
  weight: `${w.kg} kg (${w.lbs} lbs)`,
  type1: calculateDIN({ weightKg: w.kg, heightCm: w.ht, age: 30, skierType: 'I', bslMm: 305 }).din,
  type2: calculateDIN({ weightKg: w.kg, heightCm: w.ht, age: 30, skierType: 'II', bslMm: 305 }).din,
  type3: calculateDIN({ weightKg: w.kg, heightCm: w.ht, age: 30, skierType: 'III', bslMm: 305 }).din,
}));

const workedExample = calculateDIN({
  weightKg: 75,
  heightCm: 178,
  age: 30,
  skierType: 'II',
  bslMm: 305,
});

const homeContent = {
  de: {
    quickAnswerBadge: 'Kurzübersicht & Referenzleitfaden',
    quickAnswerH2: 'Welchen Z-Wert benötigen Sie für Ihre Skibindung?',
    quickAnswerP: 'Der Z-Wert (DIN) steuert das Drehmoment, bei dem die Bindung im Sturzfall auslöst. Berechnet nach ISO 11088:2023 wird Ihr Fahrercode aus Gewicht und Körpergröße ermittelt, an Fahrertyp und Alter angepasst und mit der Sohlenlänge (BSL in mm) abgeglichen.',
    exampleTitle: 'Rechenbeispiel nach ISO 11088:2023',
    profile: 'Fahrerprofil:',
    profileVal: '75 kg, 178 cm, 30 Jahre, Typ II, BSL 305mm',
    step1: 'Schritt 1 — Gewichtscode (67–78 kg):',
    step2: 'Schritt 2 — Größencode (167–178 cm):',
    step3: 'Schritt 3 — Basis-Fahrercode:',
    step3Val: 'Code K (Übereinstimmung)',
    step4: 'Schritt 4 — Fahrertyp II Anpassung:',
    step4Val: '+1 Zeilensprung → Code L',
    step5: 'Schritt 5 — Altersanpassung (30 Jahre):',
    step5Val: '0 Modifikator (Erwachsener) → Code L',
    step6: 'Schritt 6 — Sohlenlänge 305 mm Abgleich:',
    note: 'Hinweis: Alle Berechnungen liefern einen Richtwert. Die endgültige Auslöseeinstellung muss von einem qualifizierten Skiservice auf einem kalibrierten Prüfgerät getestet werden.',
    tableTitle: 'Z-Wert Richtwerte nach Gewicht (BSL 305 mm, Erwachsene)',
    tableWeight: 'Körpergewicht',
    tableType1: 'Typ I (Anfänger)',
    tableType2: 'Typ II (All-Mtn)',
    tableType3: 'Typ III (Sportlich)',
    exploreMore: 'Alle Sohlenlängen und Fahrercodes erkunden:',
    fullMatrixLink: 'Vollständige ISO 11088 Tabelle →',
    pillars: [
      { title: "Basiert auf ISO 11088:2023", desc: "Vollständige Implementierung der aktuellen Norm inklusive Konfliktlösung zwischen Größe und Gewicht sowie Altersstufen." },
      { title: "Zero-Data Architektur", desc: "Sämtliche Berechnungen finden lokal im Browser-RAM statt. Keine Cookies, kein Tracking, keine Speicherung auf Servern." },
      { title: "Service-Exportkarte", desc: "Drucken Sie Ihre Einstellwerte als kompakte Werkstattkarte für die Überprüfung im zertifizierten Skiservice aus." }
    ],
    methodologyH2: "So funktioniert die Z-Wert-Berechnung (ISO 11088)",
    methodologyDesc: "Transparente, schrittweise Ermittlung Ihrer Skibindungsauslösung.",
    methodologySteps: [
      { step: "01", title: "Basis-Fahrercode", desc: "Körpergewicht und Größe bestimmen den initialen Fahrercode (A bis M)." },
      { step: "02", title: "Fahrertyp-Anpassung", desc: "Typ I bleibt auf der Basiszeile, Typ II rückt 1 Zeile nach unten (+1 Z-Wert), Typ III um 2 Zeilen." },
      { step: "03", title: "Altersfaktor", desc: "Skifahrer unter 10 oder ab 50 Jahren rücken 1 Zeile nach oben (niedrigerer Z-Wert) zum Gelenkschutz." },
      { step: "04", title: "Sohlenlänge-Abgleich", desc: "Der finale Fahrercode wird in der ISO-Matrix mit der Sohlenlänge (BSL in mm) am Skischuh verknüpft." }
    ],
    guideH2: "Wissenswertes zur Einstellung von Skibindungen",
    guideDesc: "Alles über Auslösewerte, ISO 11088 Konformität und die sichere Handhabung."
  },
  fr: {
    quickAnswerBadge: 'Réponse Rapide & Guide de Référence',
    quickAnswerH2: 'Quel réglage DIN pour vos fixations de ski ?',
    quickAnswerP: 'Le réglage DIN contrôle le couple nécessaire pour libérer la chaussure lors d\'une chute. Calculé selon l\'ISO 11088:2023, votre code skieur de base dépend de votre poids et taille, ajusté selon le profil de skieur et l\'âge, puis croisé avec la semelle (BSL en mm).',
    exampleTitle: 'Exemple de calcul pas à pas (ISO 11088:2023)',
    profile: 'Profil du skieur :',
    profileVal: '75 kg, 178 cm, 30 ans, Type II, BSL 305mm',
    step1: 'Étape 1 — Code poids (67–78 kg) :',
    step2: 'Étape 2 — Code taille (167–178 cm) :',
    step3: 'Étape 3 — Code de base :',
    step3Val: 'Code K (Concordance)',
    step4: 'Étape 4 — Modificateur Type II :',
    step4Val: '+1 ligne → Code L',
    step5: 'Étape 5 — Modificateur âge (30 ans) :',
    step5Val: '0 modificateur (Adulte) → Code L',
    step6: 'Étape 6 — Longueur semelle 305 mm :',
    note: 'Note : Les calculs fournissent une valeur indicative. Le réglage final et le déclenchement doivent être vérifiés sur banc de test calibré par un technicien ski agréé.',
    tableTitle: 'Valeurs DIN indicatives par poids (BSL 305 mm, Adulte)',
    tableWeight: 'Poids du skieur',
    tableType1: 'Type I (Débutant)',
    tableType2: 'Type II (Polyvalent)',
    tableType3: 'Type III (Sportif)',
    exploreMore: 'Explorer toutes les longueurs de semelles et codes :',
    fullMatrixLink: 'Grille Complète ISO 11088 →',
    pillars: [
      { title: "Conforme ISO 11088:2023", desc: "Intègre la matrice complète avec arbitrage poids-taille, corrections d'âge et modificateurs de profil de ski." },
      { title: "Architecture Sans Données", desc: "Tous les calculs s'exécutent localement dans votre navigateur. Aucun cookie, aucun traceur, zéro donnée stockée." },
      { title: "Fiche Atelier Imprimable", desc: "Exportez une fiche récapitulative propre à présenter à votre technicien ski pour le réglage et le test en atelier." }
    ],
    methodologyH2: "Méthode de calcul DIN selon ISO 11088",
    methodologyDesc: "Comprendre étape par étape le réglage de déclenchement de vos fixations.",
    methodologySteps: [
      { step: "01", title: "Code de base", desc: "Le poids et la taille définissent votre lettre skieur initiale (de A à M)." },
      { step: "02", title: "Niveau de ski", desc: "Le Type I conserve la ligne de base, le Type II descend d'une ligne (+1 DIN), le Type III de 2 lignes." },
      { step: "03", title: "Facteur âge", desc: "Les skieurs de moins de 10 ans ou de 50 ans et plus remontent d'une ligne pour préserver les articulations." },
      { step: "04", title: "Croisement semelle", desc: "La ligne finale croise la colonne correspondant à la longueur de semelle en mm gravée sur la chaussure." }
    ],
    guideH2: "Comprendre le réglage de vos fixations de ski",
    guideDesc: "Tout savoir sur les normes de déclenchement, l'ISO 11088 et la sécurité sur les pistes."
  },
  it: {
    quickAnswerBadge: 'Guida Rapida & Riferimento Taratura',
    quickAnswerH2: 'Quale regolazione DIN serve per i tuoi attacchi?',
    quickAnswerP: 'Il valore DIN determina la coppia di sgancio per liberare lo scarpone durante una caduta. Calcolato secondo la norma ISO 11088:2023, il codice sciatore iniziale si basa su peso e altezza, corretto per tipo di sciatore ed età, e incrociato con la lunghezza scafo (BSL in mm).',
    exampleTitle: 'Esempio pratico di calcolo (ISO 11088:2023)',
    profile: 'Profilo sciatore:',
    profileVal: '75 kg, 178 cm, 30 anni, Tipo II, BSL 305mm',
    step1: 'Passo 1 — Codice peso (67–78 kg):',
    step2: 'Passo 2 — Codice altezza (167–178 cm):',
    step3: 'Passo 3 — Codice iniziale:',
    step3Val: 'Codice K (Concordanza)',
    step4: 'Passo 4 — Correzione Tipo II:',
    step4Val: '+1 riga → Codice L',
    step5: 'Passo 5 — Fattore età (30 anni):',
    step5Val: '0 correzione (Adulto) → Codice L',
    step6: 'Passo 6 — Incrocio scafo 305 mm:',
    note: 'Nota: I valori calcolati costituiscono una base di partenza. La taratura effettiva deve essere certificata su banco elettronico di prova da uno skiman qualificato.',
    tableTitle: 'Taratura DIN di riferimento per peso (BSL 305 mm, Adulti)',
    tableWeight: 'Peso sciatore',
    tableType1: 'Tipo I (Principiante)',
    tableType2: 'Tipo II (Intermedio)',
    tableType3: 'Tipo III (Esperto)',
    exploreMore: 'Esplora tutte le lunghezze scafo e codici sciatore:',
    fullMatrixLink: 'Tabella Completa ISO 11088 →',
    pillars: [
      { title: "Conforme ISO 11088:2023", desc: "Include l'intera matrice normativa con risoluzione dei conflitti peso-altezza e fattori correttivi per età e stile." },
      { title: "Architettura Zero Dati", desc: "Tutti i calcoli avvengono nella memoria locale del browser. Nessun cookie, nessun tracciamento e nessun dato salvato." },
      { title: "Scheda per Skiman", desc: "Esporta una scheda stampabile con i tuoi parametri di taratura da consegnare al laboratorio sci per il controllo meccanico." }
    ],
    methodologyH2: "Come funziona il calcolo DIN (ISO 11088)",
    methodologyDesc: "Spiegazione passo dopo passo per la determinazione della corretta taratura.",
    methodologySteps: [
      { step: "01", title: "Codice iniziale", desc: "Peso corporeo e altezza determinano la lettera sciatore di partenza (da A a M)." },
      { step: "02", title: "Livello sciatore", desc: "Il Tipo I usa la riga base, il Tipo II scende di 1 riga (+1 DIN), il Tipo III scende di 2 righe." },
      { step: "03", title: "Fattore età", desc: "Sciatori sotto i 10 anni o dai 50 in su salgono di 1 riga per proteggere le articolazioni." },
      { step: "04", title: "Incrocio scafo", desc: "Il codice definitivo incrocia la colonna della lunghezza scafo in mm stampata sullo scarpone." }
    ],
    guideH2: "Guida completa alla taratura degli attacchi da sci",
    guideDesc: "Tutto ciò che serve sapere su valori di sgancio, standard ISO 11088 e sicurezza sugli sci."
  },
  en: {
    quickAnswerBadge: 'Quick Answer & Reference Guide',
    quickAnswerH2: 'What DIN Setting Do You Need?',
    quickAnswerP: 'A ski binding DIN setting controls the force required to release your boot safely during a fall. Calculated under ISO 11088:2023, your baseline code is determined by your weight and height, adjusted for skier type (-I to III+) and age group, and finally mapped against your boot sole length (BSL in mm).',
    exampleTitle: 'Worked Calculation Example',
    profile: 'Skier Profile:',
    profileVal: '75 kg (165 lbs), 178 cm, 30 yrs, Type II, BSL 305mm',
    step1: 'Step 1 — Weight Code (67–78 kg):',
    step2: 'Step 2 — Height Code (167–178 cm):',
    step3: 'Step 3 — Baseline Determination:',
    step3Val: 'Code K (Agreement)',
    step4: 'Step 4 — Skier Type II Shift:',
    step4Val: '+1 Row Shift → Code L',
    step5: 'Step 5 — Age Modifier (30 years):',
    step5Val: '0 Modifier (Adult) → Final Code L',
    step6: 'Step 6 — BSL 305 mm Lookup:',
    note: 'Note: All calculations provide a baseline setting. Final release calibration must be verified on diagnostic test equipment by a trained ski technician.',
    tableTitle: 'Baseline DIN by Weight (BSL 305 mm, Adult)',
    tableWeight: 'Skier Weight',
    tableType1: 'Type I (Beginner)',
    tableType2: 'Type II (All-Mtn)',
    tableType3: 'Type III (Aggressive)',
    exploreMore: 'Explore all boot sole lengths and skier codes:',
    fullMatrixLink: 'Full ISO 11088 Matrix →',
    pillars: [
      { title: "Based on ISO 11088:2023", desc: "Implements the full ISO 11088:2023 matrix including height-weight conflict resolution, age modifiers, and horizontal nearest-neighbor fallback logic." },
      { title: "Zero-Data Architecture", desc: "All calculations run in browser RAM. Your weight, height, age, and boot size are never sent to a server, stored in cookies, or logged anywhere." },
      { title: "Technician Export Card", desc: "Export a clean, printable summary card with your DIN settings to share with a trained ski technician for binding mounting and calibration." }
    ],
    methodologyH2: "How the ISO 11088 math works.",
    methodologyDesc: "A transparent, step-by-step breakdown of how your DIN value is calculated.",
    methodologySteps: [
      { step: "01", title: "Baseline Force", desc: "Body weight and height determine your initial Skier Code and safe threshold." },
      { step: "02", title: "Ability Shift", desc: "Your Skier Type modifies the code: Type I uses the baseline row, Type II moves 1 row lower on the chart, Type III moves 2 rows lower." },
      { step: "03", title: "Age Modifier", desc: "Skiers under 10 or age 50+ move 1 row higher on the chart (lower DIN) for bone and joint safety." },
      { step: "04", title: "Matrix Lookup", desc: "Your final Skier Code intersects with your Boot Sole Length on the ISO 11088:2023 matrix." }
    ],
    guideH2: "Understanding Your Ski Binding DIN Setting",
    guideDesc: "Everything you need to know about ski binding release settings, ISO 11088 compliance, and how to use a DIN calculator safely."
  }
};

const c = (homeContent as any)[lang] || homeContent.en;
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <!-- HERO — Keyword-focused H1 & Value Proposition -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.04]" style="background-image: linear-gradient(var(--theme-hairline) 1px, transparent 1px), linear-gradient(90deg, var(--theme-hairline) 1px, transparent 1px); background-size: 48px 48px;"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[500px] h-[200px] rounded-full opacity-10 dark:opacity-[0.05] blur-3xl" style="background: radial-gradient(circle, #FF6B00 0%, transparent 70%);"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-8 sm:pt-16 sm:pb-10 text-center">
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold text-ink tracking-tight leading-[1.1] mb-3">
        {lang === 'de' ? 'Z-Wert Rechner Skibindung' : lang === 'fr' ? 'Calculateur DIN Fixations de Ski' : lang === 'it' ? 'Calcolatore DIN Attacchi Sci' : 'Ski DIN Calculator'}
      </h1>
      <p class="text-sm sm:text-base text-mute max-w-2xl mx-auto mb-6 leading-relaxed">
        {lang === 'de' 
          ? 'Kostenloser Skibindungs-Rechner nach ISO 11088:2023. Ermitteln Sie Ihren Richtwert transparent in wenigen Sekunden.' 
          : lang === 'fr' 
          ? 'Calculateur de réglage DIN pour fixations de ski selon ISO 11088:2023. Gratuit, instantané et transparent.' 
          : lang === 'it' 
          ? 'Calcolo taratura attacchi da sci secondo la norma ISO 11088:2023. Gratuito, trasparente e immediato.' 
          : 'Free ski binding release calculator based on ISO 11088:2023 (Edition 7). Calculate your recommended DIN setting in seconds.'}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 mb-5">
        <a href="#calculator" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-primary text-white font-semibold text-sm transition-all hover:opacity-90 hover:scale-[1.02] shadow-lg" style="box-shadow: 0 4px 24px -4px color-mix(in srgb, var(--theme-primary) 50%, transparent);">
          {t('cta.calcMyDin')}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href={getRouteFromUrl(new URL('/din-chart/', siteUrl), lang)} class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-hairline bg-parchment text-ink font-medium text-sm transition-all hover:border-primary/50 hover:bg-canvas">
          {t('cta.matrixTable')}
        </a>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1.5 text-xs text-mute">
        <span class="flex items-center gap-1.5"><svg class="w-3 h-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Based on ISO 11088:2023</span>
        <span class="flex items-center gap-1.5"><svg class="w-3 h-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Cookieless & Private</span>
        <span class="flex items-center gap-1.5"><svg class="w-3 h-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Free & Open-Source</span>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       CALCULATOR SECTION
  ══════════════════════════════════════════════ -->
  <section id="calculator" class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <!-- Divider label -->
    <div class="flex items-center gap-4 mb-8">
      <div class="h-px flex-1 bg-hairline"></div>
      <span class="text-[11px] font-mono font-semibold text-mute uppercase tracking-widest px-3">Calculator</span>
      <div class="h-px flex-1 bg-hairline"></div>
    </div>

    <CalculatorApp client:load lang={lang} />

    <!-- Trust Strip -->
    <div class="mt-6 p-4 rounded-xl bg-parchment border border-hairline flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-mute">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Based on <strong>ISO 11088:2023</strong> (Edition 7) · Engine v2.0.0 · Independent project</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/methodology/" class="text-primary hover:underline font-medium">Methodology & Limitations →</a>
        <a href="/changelog/" class="text-primary hover:underline font-medium">Changelog →</a>
      </div>
    </div>

    <!-- ANSWER-FIRST BLOCK — Crawlable answers & worked example (ISO 11088:2023) -->
    <div class="mt-10 p-6 sm:p-8 rounded-2xl bg-canvas border border-hairline shadow-sm space-y-6">
      <div class="border-b border-hairline pb-4">
        <div class="flex items-center gap-2 text-xs font-mono text-accent uppercase tracking-wider mb-1">
          <span>{c.quickAnswerBadge}</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-ink">
          {c.quickAnswerH2}
        </h2>
        <p class="text-sm text-mute leading-relaxed mt-2">
          {c.quickAnswerP}
        </p>
      </div>

      <!-- Worked Example & Quick Table Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Worked Example Breakdown -->
        <div class="lg:col-span-6 space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold text-ink">{c.exampleTitle}</h3>
            <span class="text-xs font-mono text-mute">ISO 11088:2023</span>
          </div>
          <div class="p-4 rounded-xl bg-parchment border border-hairline space-y-3 text-xs">
            <div class="flex justify-between py-1 border-b border-hairline/60">
              <span class="text-mute">{c.profile}</span>
              <span class="font-mono font-medium text-ink">{c.profileVal}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-hairline/60">
              <span class="text-mute">{c.step1}</span>
              <span class="font-mono font-semibold text-ink">Code K</span>
            </div>
            <div class="flex justify-between py-1 border-b border-hairline/60">
              <span class="text-mute">{c.step2}</span>
              <span class="font-mono font-semibold text-ink">Code K</span>
            </div>
            <div class="flex justify-between py-1 border-b border-hairline/60">
              <span class="text-mute">{c.step3}</span>
              <span class="font-mono font-semibold text-ink">{c.step3Val}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-hairline/60">
              <span class="text-mute">{c.step4}</span>
              <span class="font-mono font-semibold text-accent">{c.step4Val}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-hairline/60">
              <span class="text-mute">{c.step5}</span>
              <span class="font-mono text-ink">{c.step5Val}</span>
            </div>
            <div class="flex justify-between items-center pt-1 text-sm font-bold text-ink">
              <span>{c.step6}</span>
              <span class="text-primary font-mono text-base px-2.5 py-0.5 rounded bg-primary/10 border border-primary/20">DIN {workedExample.din}</span>
            </div>
          </div>
          <p class="text-[11px] text-mute italic">
            {c.note}
          </p>
        </div>

        <!-- Quick Reference by Weight Table -->
        <div class="lg:col-span-6 space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold text-ink">{c.tableTitle}</h3>
            <span class="text-xs font-mono text-mute">BSL 291–310 mm</span>
          </div>
          <div class="overflow-x-auto rounded-xl border border-hairline bg-parchment">
            <table class="w-full text-xs text-left">
              <thead class="bg-input/70 border-b border-hairline text-mute font-mono">
                <tr>
                  <th class="px-3 py-2">{c.tableWeight}</th>
                  <th class="px-3 py-2 text-center">{c.tableType1}</th>
                  <th class="px-3 py-2 text-center font-semibold text-ink">{c.tableType2}</th>
                  <th class="px-3 py-2 text-center">{c.tableType3}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline font-mono">
                {quickTable.map((row) => (
                  <tr class="hover:bg-canvas/50 transition-colors">
                    <td class="px-3 py-2 text-ink font-medium">{row.weight}</td>
