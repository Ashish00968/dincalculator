  { mondo: '22.0 / 22.5', usMen: '4.5 / 5.0', usWomen: '5.5 / 6.0', eu: '35.5 / 36', typicalBsl: '265 mm' },
  { mondo: '23.0 / 23.5', usMen: '5.5 / 6.0', usWomen: '6.5 / 7.0', eu: '37 / 37.5', typicalBsl: '275 mm' },
  { mondo: '24.0 / 24.5', usMen: '6.5 / 7.0', usWomen: '7.5 / 8.0', eu: '38 / 39', typicalBsl: '285 mm' },
  { mondo: '25.0 / 25.5', usMen: '7.5 / 8.0', usWomen: '8.5 / 9.0', eu: '40 / 40.5', typicalBsl: '295 mm' },
  { mondo: '26.0 / 26.5', usMen: '8.5 / 9.0', usWomen: '9.5 / 10.0', eu: '41 / 42', typicalBsl: '305 mm' },
  { mondo: '27.0 / 27.5', usMen: '9.5 / 10.0', usWomen: '10.5 / 11.0', eu: '42.5 / 43', typicalBsl: '315 mm' },
  { mondo: '28.0 / 28.5', usMen: '10.5 / 11.0', usWomen: '11.5 / 12.0', eu: '44 / 44.5', typicalBsl: '325 mm' },
  { mondo: '29.0 / 29.5', usMen: '11.5 / 12.0', usWomen: '12.5 / 13.0', eu: '45 / 46', typicalBsl: '335 mm' },
  { mondo: '30.0 / 30.5', usMen: '12.5 / 13.0', usWomen: '—', eu: '46.5 / 47', typicalBsl: '345 mm' },
  { mondo: '31.0 / 31.5', usMen: '13.5 / 14.0', usWomen: '—', eu: '48 / 49', typicalBsl: '355 mm' },
];

const bslContent = {
  de: {
    badge: 'MESSVORSCHRIFT',
