    desc: 'Alles Wissenswerte über das Messen, Ablesen und Umrechnen der Sohlenlänge (in mm) für die korrekte Z-Wert-Berechnung.',
    distinctionH2: 'Mondopoint vs. Sohlenlänge (BSL)',
    distinctionP: 'Der häufigste Fehler beim Berechnen des Z-Werts ist die Eingabe der Mondopoint-Größe (z. B. 27,5) statt der tatsächlichen Sohlenlänge (z. B. 315 mm).',
    mondoTitle: 'Mondopoint-Größe:',
    mondoDesc: 'Die Innenfuß- bzw. Innenschuhlänge in Zentimetern (z. B. 26,5 cm).',
    bslTitle: 'Sohlenlänge (BSL):',
    bslDesc: 'Die gesamte äußere Schalenlänge in Millimetern (z. B. 305 mm).',
    diagramCaption: 'Fersenprägung: "305 mm" (BSL)',
    methodsH2: '3 Wege zur Ermittlung Ihrer Sohlenlänge',
    method1Title: 'Fersenbacke überprüfen',
    method1Desc: 'Bei 95 % aller Skischuhe (Salomon, Atomic, Head, Lange, Rossignol, Tecnica) ist die dreistellige Millimeterzahl seitlich oder unter der Ferse eingeprägt.',
    method2Title: 'Von Spitze bis Ferse messen',
    method2Desc: 'Ist die Prägung durch Asphalt unleserlich, messen Sie mit einem Maßband exakt von der hinteren Fersenkante bis zur vorderen Spitze der Sohle.',
    method3Title: 'Mondopoint-Tabelle nutzen',
    method3Desc: 'Nutzen Sie die untenstehende Richtwerttabelle zur Schätzung. Hinweis: Schalenformen variieren je nach Hersteller um ±3–8 mm.',
    tableH2: 'Umrechnungstabelle Mondopoint zu typischer Sohlenlänge (BSL)',
    tableThMondo: 'Mondo (cm)',
    tableThUsMen: 'US Herren',
    tableThUsWomen: 'US Damen',
    tableThEu: 'EU-Größe',
    tableThBsl: 'Typische BSL',
    ctaH3: 'Sohlenlänge parat?',
    ctaP: 'Berechnen Sie jetzt Ihren präzisen Z-Wert nach ISO 11088 in Millisekunden.'
  },
  fr: {
    badge: 'SPÉCIFICATION DE MESURE',
    title: 'Trouver la Longueur de Semelle (BSL)',
    desc: 'Tout savoir pour mesurer, repérer et convertir la longueur de semelle en millimètres pour un réglage DIN précis.',
    distinctionH2: 'Mondopoint vs. Longueur de Semelle (BSL)',
    distinctionP: 'L\'erreur la plus fréquente des skieurs consiste à renseigner leur taille Mondopoint (ex. 27.5) au lieu de la longueur de semelle extérieure (ex. 315 mm).',
    mondoTitle: 'Pointure Mondopoint :',
    mondoDesc: 'La dimension du chausson interne en centimètres (ex. 26,5 cm).',
    bslTitle: 'Longueur de Semelle (BSL) :',
    bslDesc: 'La longueur extérieure totale de la coque en millimètres (ex. 305 mm).',
    diagramCaption: 'Marquage talon : "305 mm" (BSL)',
    methodsH2: '3 méthodes pour trouver votre BSL',
    method1Title: 'Examiner le talon de la chaussure',
    method1Desc: 'Sur 95 % des chaussures (Salomon, Atomic, Head, Lange, Rossignol, Tecnica), le nombre à 3 chiffres en mm est moulé sur le côté ou sous le talon.',
    method2Title: 'Mesurer de bout en bout',
    method2Desc: 'Si l\'empreinte est effacée par l\'usure, mesurez au mètre ruban du bord extrême de la talonnière jusqu\'à la pointe de la butée avant.',
    method3Title: 'Consulter la grille de conversion',
    method3Desc: 'Utilisez la grille ci-dessous pour estimer votre BSL. Attention : les moules de coque varient de ±3 à 8 mm selon les fabricants.',
    tableH2: 'Tableau de conversion Mondopoint vers Longueur de Semelle typique',
    tableThMondo: 'Mondo (cm)',
    tableThUsMen: 'US Homme',
    tableThUsWomen: 'US Femme',
    tableThEu: 'Taille EU',
    tableThBsl: 'BSL Moyenne',
    ctaH3: 'Prêt avec votre semelle ?',
    ctaP: 'Calculez instantanément votre valeur de déclenchement ISO 11088.'
  },
  it: {
    badge: 'SPECIFICA DI MISURA',
    title: 'Lunghezza Scafo Scarpone (BSL) in mm',
    desc: 'Tutto quello che serve per individuare, misurare e convertire la lunghezza scafo in millimetri per una taratura DIN corretta.',
    distinctionH2: 'Mondo Point vs. Lunghezza Scafo (BSL)',
    distinctionP: 'L\'errore più comune commesso dagli sciatori è inserire la taglia Mondopoint (es. 27.5) anziché la lunghezza scafo esterna (es. 315 mm).',
