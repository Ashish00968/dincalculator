    methodsH2: '3 metodi per individuare la misura BSL',
    method1Title: 'Esamina il tacco dello scarpone',
    method1Desc: 'Nel 95% degli scarponi da sci (Salomon, Atomic, Head, Lange, Rossignol, Tecnica), il valore a 3 cifre in millimetri è inciso sul lato o sotto il tallone.',
    method2Title: 'Misura da punta a coda',
    method2Desc: 'Se la scritta è abrasa dalla camminata su asfalto, rileva la misura esatta con un metro millimetrico dall\'estremità posteriore del tacco alla punta anteriore.',
    method3Title: 'Consulta la tabella Mondopoint',
    method3Desc: 'Usa la tabella sottostante per risalire alla BSL tipica. Attenzione: le plastiche degli scarponi variano di ±3–8 mm a seconda della marca.',
    tableH2: 'Tabella di conversione taglia Mondopoint e BSL tipica',
    tableThMondo: 'Mondo (cm)',
    tableThUsMen: 'US Uomo',
    tableThUsWomen: 'US Donna',
    tableThEu: 'Taglia EU',
    tableThBsl: 'BSL Tipica',
    ctaH3: 'Hai la misura della suola?',
    ctaP: 'Calcola subito la taratura corretta ISO 11088 in pochi millisecondi.'
  },
  en: {
    badge: 'MEASUREMENT SPECIFICATION',
    title: 'Boot Sole Length (BSL) Guide',
    desc: 'Everything you need to know about measuring, locating, and converting your ski boot\'s millimeter sole dimension for safe DIN calculations.',
    distinctionH2: 'Mondo Point vs. Boot Sole Length',
    distinctionP: 'The most common mistake skiers make is inputting their Mondo size (e.g., 27.5) into a DIN calculator instead of their Boot Sole Length (e.g., 315mm).',
    mondoTitle: 'Mondo Size:',
    mondoDesc: 'The inner foot/liner size in centimeters (e.g., 26.5 cm).',
    bslTitle: 'Boot Sole Length (BSL):',
    bslDesc: 'Total physical exterior shell length in millimeters (e.g., 305 mm).',
    diagramCaption: 'Heel Stamp: "305 mm" (BSL)',
    methodsH2: '3 ways to find your BSL.',
    method1Title: 'Examine the Heel Lug',
    method1Desc: 'In 95% of ski boots (Salomon, Atomic, Head, Lange, Rossignol, Tecnica), the 3-digit millimeter number is molded directly on the side or bottom of the heel.',
    method2Title: 'Measure Tip-to-Tail',
    method2Desc: 'If the stamp has worn away from walking on parking lot asphalt, measure with a metric millimeter tape from the back of the heel lug to the tip of the toe lug.',
    method3Title: 'Lookup Mondo Conversion',
    method3Desc: 'Use the chart below to estimate typical BSL from your Mondo or US shoe size. Note: boot shell molds vary by brand by ±3–8mm.',
    tableH2: 'Mondo Size to Typical BSL Conversion Table',
    tableThMondo: 'Mondo (cm)',
    tableThUsMen: 'US Men',
    tableThUsWomen: 'US Women',
    tableThEu: 'EU Size',
    tableThBsl: 'Typical BSL',
    ctaH3: 'Ready with your BSL?',
    ctaP: 'Compute your exact ISO 11088 binding release setting in milliseconds.'
  }
};

const c = (bslContent as any)[lang] || bslContent.en;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    {/* Header */}
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-parchment border border-hairline text-ink text-xs font-mono mb-4 shadow-sm">
        <span>{c.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold text-ink tracking-tight mb-4">
        {c.title}
      </h1>
      <p class="text-mute text-sm sm:text-base leading-relaxed">
        {c.desc}
      </p>
    </div>

    {/* Distinction Card */}
    <div class="mb-14 p-6 sm:p-8 rounded-2xl bg-parchment border border-hairline shadow-sm relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-primary to-orange-400"></div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div>
          <h2 class="text-xl font-semibold text-ink mb-3">{c.distinctionH2}</h2>
          <p class="text-xs text-mute leading-relaxed mb-4">
            {c.distinctionP}
          </p>
          <ul class="space-y-2 text-xs text-ink">
            <li class="flex items-start gap-2">
              <span class="text-rose-600 dark:text-rose-400 font-mono font-bold">✕</span>
              <span><strong>{c.mondoTitle}</strong> {c.mondoDesc}</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-700 dark:text-emerald-400 font-mono font-bold">✓</span>
              <span><strong>{c.bslTitle}</strong> {c.bslDesc}</span>
            </li>
          </ul>
        </div>

        {/* Diagram Box */}
        <div class="p-6 rounded-xl bg-canvas border border-hairline flex flex-col items-center justify-center shadow-inner">
          <svg viewBox="0 0 240 90" class="w-full h-28" fill="none">
            <path
              d="M 50 15 C 60 15, 65 35, 75 45 L 140 45 C 160 45, 195 55, 205 75 L 205 85 L 25 85 L 25 45 C 25 25, 40 15, 50 15 Z"
              fill="var(--theme-parchment)"
              stroke="var(--theme-ink)"
              stroke-width="2"
            ></path>
            {/* Sole Lug highlights */}
            <rect x="22" y="78" width="30" height="9" rx="2" fill="var(--theme-canvas)" stroke="var(--theme-hairline)" stroke-width="1"></rect>
            <rect x="175" y="78" width="35" height="9" rx="2" fill="var(--theme-canvas)" stroke="var(--theme-hairline)" stroke-width="1"></rect>
            {/* Heel stamp */}
            <circle cx="37" cy="82" r="5.5" fill="var(--theme-primary)"></circle>
            <text x="37" y="84" font-size="5" font-weight="bold" fill="#ffffff" text-anchor="middle" font-family="monospace">
              305
            </text>
            {/* Dimension Arrow */}
            <line x1="22" y1="90" x2="210" y2="90" stroke="var(--theme-primary)" stroke-width="1.5" stroke-dasharray="3 3"></line>
          </svg>
          <span class="caption-mono text-primary font-bold mt-2">
            {c.diagramCaption}
          </span>
        </div>
      </div>
    </div>

    {/* 3 Step Guide */}
    <div class="mb-14">
      <h2 class="text-xl font-semibold text-ink mb-6 text-center">{c.methodsH2}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-parchment border border-hairline space-y-3 shadow-sm">
          <span class="caption-mono text-mute">Method 01</span>
          <h3 class="text-sm font-semibold text-ink">{c.method1Title}</h3>
          <p class="text-xs text-mute leading-relaxed">
            {c.method1Desc}
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-parchment border border-hairline space-y-3 shadow-sm">
          <span class="caption-mono text-mute">Method 02</span>
          <h3 class="text-sm font-semibold text-ink">{c.method2Title}</h3>
          <p class="text-xs text-mute leading-relaxed">
            {c.method2Desc}
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-parchment border border-hairline space-y-3 shadow-sm">
          <span class="caption-mono text-mute">Method 03</span>
          <h3 class="text-sm font-semibold text-ink">{c.method3Title}</h3>
          <p class="text-xs text-mute leading-relaxed">
            {c.method3Desc}
          </p>
        </div>
      </div>
    </div>

    {/* Sizing Chart */}
    <div class="mb-16">
      <div class="mb-4">
        <h2 class="text-lg font-semibold text-ink">
          {c.tableH2}
        </h2>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-hairline bg-parchment shadow-sm">
        <table class="w-full text-xs text-left">
          <thead class="caption-mono bg-canvas text-mute border-b border-hairline">
            <tr>
              <th class="px-5 py-3.5">{c.tableThMondo}</th>
              <th class="px-5 py-3.5">{c.tableThUsMen}</th>
              <th class="px-5 py-3.5">{c.tableThUsWomen}</th>
              <th class="px-5 py-3.5">{c.tableThEu}</th>
              <th class="px-5 py-3.5 text-right">{c.tableThBsl}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline font-mono">
            {mondoTable.map((row) => (
              <tr class="hover:bg-canvas/50 transition-colors">
                <td class="px-5 py-3 font-semibold text-ink">{row.mondo}</td>
                <td class="px-5 py-3 text-mute">{row.usMen}</td>
                <td class="px-5 py-3 text-mute">{row.usWomen}</td>
                <td class="px-5 py-3 text-mute">{row.eu}</td>
                <td class="px-5 py-3 text-right font-bold text-primary">{row.typicalBsl}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    {/* Call to action */}
    <div class="p-8 rounded-2xl bg-parchment border border-hairline flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm">
      <div>
        <h3 class="text-base font-semibold text-ink mb-1">{c.ctaH3}</h3>
        <p class="text-xs text-mute">{c.ctaP}</p>
      </div>
      <a
        href={getRouteFromUrl(new URL('/', siteUrl), lang)}
        class="px-6 py-2.5 rounded-full bg-primary hover:bg-accent-hover text-white font-semibold text-xs transition-all shadow-md shrink-0"
      >
        {t('cta.openCalc')}
      </a>
    </div>
  </div>
</BaseLayout>
