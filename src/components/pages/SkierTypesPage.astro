      },
      {
        code: 'Type II',
        title: 'Intermédiaire / Polyvalent',
        modifier: '+1 Ligne',
        speed: 'Allure soutenue à rapide',
        terrain: 'Pistes bleues et rouges variées',
        release: 'Équilibre optimal entre maintien et sécurité',
        description: 'Correspond à la majorité des skieurs adultes réguliers. Maintient solidement la chaussure en virage tout en libérant efficacement lors d\'un choc violent.'
      },
      {
        code: 'Type III',
        title: 'Sportif / Confirmé',
        modifier: '+2 Lignes',
        speed: 'Très rapide sur pentes raides',
        terrain: 'Pistes noires, bosses et couloirs',
        release: 'Rétention forte ; déclenche lors de chutes violentes',
        description: 'Skieurs expérimentés générant d\'importantes forces centrifuges où un déchaussage involontaire représenterait un danger vital.'
      },
      {
        code: 'Type III+',
        title: 'Compétiteur / Freeride Extrême',
        modifier: '+3 Lignes (Usage atelier)',
        speed: 'Vitesse de compétition maximale',
        terrain: 'Stades de slalom et barres rocheuses',
        release: 'Rétention mécanique maximale',
        description: 'Skieurs de compétition acceptant le risque articulaire pour empêcher un déchaussage catastrophique à très haute vitesse.'
      }
    ]
  },
  it: {
    badge: 'PROFILO SCIATORE ISO 11088',
    title: 'Classificazione del Tipo di Sciatore',
    desc: 'Il tipo di sciatore determina l\'equilibrio essenziale tra lo sgancio protettivo in caduta e la tenuta meccanica nelle curve ad alta velocità.',
    isoModifierLabel: 'Modificatore ISO:',
    speedLabel: 'Velocità preferita',
    terrainLabel: 'Terreno abituale',
    releaseLabel: 'Sgancio vs Tenuta',
    safetyTitle: 'Perché non dovresti mai sovrastimare il tuo tipo di sciatore',
    safetyP1: 'Molti sciatori intermedi richiedono regolazioni di Tipo III convinti che un valore più alto certifichi una migliore abilità. Nella realtà, impostare gli attacchi su Tipo III senza produrre forze dinamiche elevate impedisce l\'apertura in caduta rotazionale, provocando gravi fratture tibiali o rotture del legamento crociato anteriore.',
    safetyP2: 'Scegli sempre la classificazione più bassa che prevenga con sicurezza gli sganci involontari durante la tua normale sciata.',
    types: [
      {
        code: 'Tipo -I',
        title: 'Estremamente Prudente',
        modifier: '-1 Riga in su',
        speed: 'Molto lenta su pendii facili',
        terrain: 'Campi scuola e piste verdi',
        release: 'Sgancio immediato alla minima sollecitazione',
        description: 'Studiato per principianti assoluti, bambini o individui con precedenti lesioni articolari che danno priorità assoluta allo sgancio.'
      },
      {
        code: 'Tipo I',
        title: 'Prudente / Principiante',
        modifier: '0 Righe (Riga base)',
        speed: 'Andatura controllata da lenta a media',
        terrain: 'Piste facili e medie battute',
        release: 'Sgancia agevolmente per proteggere le articolazioni',
        description: 'Il profilo di riferimento della norma ISO 11088. Favorisce lo sgancio tempestivo in caso di caduta per salvaguardare le ginocchia.'
      },
      {
        code: 'Tipo II',
        title: 'Intermedio / All-Mountain',
        modifier: '+1 Riga in giù',
        speed: 'Andatura media e sostenuta',
        terrain: 'Piste rosse e pendii variati',
        release: 'Equilibrio ottimale tra tenuta e rilascio',
        description: 'Rappresenta la stragrande maggioranza degli sciatori adulti. Garantisce tenuta in curva condotta e sgancio affidabile nelle cadute ad alta energia.'
      },
      {
        code: 'Tipo III',
        title: 'Esperto / Aggressivo',
        modifier: '+2 Righe in giù',
        speed: 'Molto veloce su pendii ripidi',
        terrain: 'Piste nere, gobbe, neve fresca e boschi',
        release: 'Elevata forza di tenuta; sgancia solo in cadute violente',
        description: 'Sciatori esperti che affrontano forti accelerazioni e forze G, dove uno sgancio involontario comporterebbe conseguenze pericolose.'
      },
      {
        code: 'Tipo III+',
        title: 'Agonista / Freeride Estremo',
        modifier: '+3 Righe in giù (Costruttore)',
        speed: 'Ritmo da gara di Coppa del Mondo',
        terrain: 'Piste da gara FIS e canali ripidi',
        release: 'Massima tenuta meccanica',
        description: 'Atleti agonisti che accettano un rischio articolare elevato per scongiurare un disastroso sgancio ad altissima velocità.'
      }
    ]
  },
  en: {
    badge: 'ISO 11088 CLASSIFICATION STANDARD',
    title: 'Choosing your skier type.',
    desc: 'Your Skier Type is NOT your ego—it is a critical mechanical setting that determines the balance between accidental release and emergency retention.',
    isoModifierLabel: 'ISO Modifier:',
    speedLabel: 'Speed Preference',
    terrainLabel: 'Typical Terrain',
    releaseLabel: 'Release vs Retention',
    safetyTitle: 'Why You Should Never "Over-Classify" Your Skier Type',
    safetyP1: 'Many intermediate skiers mistakenly request Type III settings under the assumption that a higher number makes them look like better skiers. In reality, setting bindings to Type III when you do not generate sufficient dynamic force to trigger an emergency release significantly elevates the risk of spiral tibia fractures and ACL/MCL knee ligament tears during a fall.',
    safetyP2: 'Always select the lowest skier type that reliably prevents inadvertent pre-release during your normal skiing routine.',
    types: [
      {
        code: 'Type -I',
        title: 'Extremely Cautious',
        modifier: '-1 Row Step',
        speed: 'Very slow on flat slopes',
        terrain: 'Magic carpets & beginner nursery slopes',
        release: 'Releases at minimum threshold at the slightest fall',
        description: 'Designed specifically for brand new skiers, juniors, or individuals with preexisting joint or ligament concerns who prioritize premature release over retention.'
      },
      {
        code: 'Type I',
        title: 'Cautious / Beginner',
        modifier: '0 Steps (Baseline)',
        speed: 'Slow to moderate cruising',
        terrain: 'Green circles and gentle groomed blue runs',
        release: 'Releases easily to protect developing technique',
        description: 'The standard baseline profile. Prefers binding settings that release quickly in a fall rather than risking knee or lower leg injury.'
      },
      {
        code: 'Type II',
        title: 'Moderate / All-Mountain',
        modifier: '+1 Row Step',
        speed: 'Moderate to fast cruising',
        terrain: 'Blue cruisers, mild black diamonds, and varied groomed terrain',
        release: 'Balanced release tension resisting unwanted release on groomers',
        description: 'Represents the vast majority of recreational adult skiers. Balances reliable retention during carved turns with timely release during higher-energy falls.'
      },
      {
        code: 'Type III',
        title: 'Aggressive / Expert',
        modifier: '+2 Row Steps',
        speed: 'Fast to very fast on steep slopes',
        terrain: 'Steep black/double-black groomers, moguls, powder, and trees',
        release: 'High retention force; releases only in severe high-impact crashes',
        description: 'Experienced skiers who regularly encounter aggressive G-forces in bumps or steeps where an accidental pre-release could cause catastrophic falls.'
      },
      {
        code: 'Type III+',
        title: 'Racer / Extreme Freeride',
        modifier: '+3 Row Steps (Custom)',
        speed: 'Full competition race pace / cliff drops',
        terrain: 'FIS race courses, extreme backcountry couloirs, high park jumps',
        release: 'Maximum mechanical retention; high risk of injury in twisting falls',
        description: 'Elite competitors and extreme freeriders who accept substantial joint injury risk to prevent catastrophic high-speed binding release.'
      }
    ]
  }
};

const c = (skierTypesContent as any)[lang] || skierTypesContent.en;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    {/* Page Header */}
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-parchment border border-hairline text-ink text-xs font-semibold mb-4 shadow-sm uppercase tracking-widest">
        <span>{c.badge}</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-bold text-ink tracking-tight mb-4">
        {c.title}
      </h1>
      <p class="text-mute text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        {c.desc}
      </p>
    </div>

    {/* Skier Types Cards */}
    <div class="space-y-4 mb-16">
      {c.types.map((type: any) => (
        <div class="p-8 rounded-[24px] bg-canvas border border-hairline shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4 pb-4 border-b border-hairline">
            <div class="flex items-center gap-3">
              <span class="px-3 py-1 rounded-md text-sm font-semibold bg-parchment text-ink">
                {type.code}
              </span>
              <h2 class="text-lg font-semibold text-ink">{type.title}</h2>
            </div>
            <div class="text-sm text-mute">
              {c.isoModifierLabel} <span class="text-primary font-semibold">{type.modifier}</span>
            </div>
          </div>

          <p class="text-sm text-mute leading-relaxed mb-6">
            {type.description}
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
            <div class="p-4 rounded-[16px] bg-parchment border border-hairline">
              <span class="text-xs text-mute block mb-1">{c.speedLabel}</span>
              <span class="text-ink font-medium">{type.speed}</span>
            </div>
            <div class="p-4 rounded-[16px] bg-parchment border border-hairline">
              <span class="text-xs text-mute block mb-1">{c.terrainLabel}</span>
              <span class="text-ink font-medium">{type.terrain}</span>
            </div>
            <div class="p-4 rounded-[16px] bg-parchment border border-hairline">
              <span class="text-xs text-mute block mb-1">{c.releaseLabel}</span>
              <span class="text-ink font-medium">{type.release}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* Crucial Safety Notice */}
    <div class="p-8 rounded-[24px] bg-parchment border border-hairline space-y-4 mb-14">
      <h3 class="text-lg font-semibold text-ink flex items-center gap-2">
        <svg class="w-5 h-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        {c.safetyTitle}
      </h3>
      <p class="text-sm text-mute leading-relaxed">
        {c.safetyP1}
      </p>
      <p class="text-sm text-mute leading-relaxed">
        {c.safetyP2}
      </p>
    </div>

    {/* Call to action */}
    <div class="text-center">
      <a
        href={getRouteFromUrl(new URL('/', siteUrl), lang)}
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-primary hover:scale-[0.98] text-canvas font-medium text-sm transition-transform cursor-pointer"
      >
        {t('cta.calcDinNow')}
      </a>
    </div>
  </div>
</BaseLayout>
