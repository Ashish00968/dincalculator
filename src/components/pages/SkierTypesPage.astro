---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, getRouteFromUrl } from '../../i18n/utils';
import type { ui } from '../../i18n/ui';

interface Props {
  lang?: keyof typeof ui;
}

const { lang = (Astro.params.lang as keyof typeof ui) || 'en' } = Astro.props;
const t = useTranslations(lang);
const siteUrl = 'https://dincalculatorpro.com';

const pageTitle = t('page.skierTypes.title');
const pageDescription = t('page.skierTypes.desc');

const skierTypesContent = {
  de: {
    badge: 'ISO 11088 FAHRERTYP-NORM',
    title: 'Fahrertypen beim Skifahren (ISO 11088)',
    desc: 'Ihr Fahrertyp steuert das mechanische Gleichgewicht zwischen rechtzeitiger Auslösung bei Stürzen und sicherem Halt bei dynamischen Schwüngen.',
    isoModifierLabel: 'ISO-Modifikator:',
    speedLabel: 'Geschwindigkeit',
    terrainLabel: 'Gelände',
    releaseLabel: 'Auslösung vs. Halt',
    safetyTitle: 'Warum Sie sich niemals als höheren Fahrertyp einstufen sollten',
    safetyP1: 'Viele Skifahrer stufen sich fälschlicherweise als Typ III ein, in dem Glauben, dass eine höhere Zahl fahrtechnisches Können signalisiert. Bindungen auf Typ III zu stellen, ohne die erforderlichen G-Kräfte aufzubauen, steigert jedoch drastisch das Risiko von Spiralfrakturen des Schienbeins und Kreuzbandrissen im Sturzfall.',
    safetyP2: 'Wählen Sie stets die niedrigste Einstufung, die ein ungewolltes vorzeitiges Auslösen bei Ihrem normalen Fahrstil verlässlich verhindert.',
    types: [
      {
        code: 'Typ -I',
        title: 'Äußerst Vorsichtig',
        modifier: '-1 Zeilensprung',
        speed: 'Sehr langsam auf flachen Hängen',
        terrain: 'Übungshänge und Anfängerbereiche',
        release: 'Löst bereits bei minimaler Krafteinwirkung sofort aus',
        description: 'Speziell für absolute Fahranfänger, Kinder oder Skifahrer mit Vorerkrankungen der Bänder, bei denen Schutz vor Überlastung absoluten Vorrang vor dem Festhaltemoment hat.'
      },
      {
        code: 'Typ I',
        title: 'Vorsichtig / Einsteiger',
        modifier: '0 Sprünge (Basiszeile)',
        speed: 'Mäßiges bis ruhiges Gleiten',
        terrain: 'Blaue Pisten und einfache Abfahrten',
        release: 'Löst leicht und frühzeitig aus',
        description: 'Das klassische Basisprofil nach ISO 11088. Bevorzugt Einstellungen, die bei jedem Sturz sofort freigeben, um Verletzungen des Kniegelenks zu vermeiden.'
      },
      {
        code: 'Typ II',
        title: 'Fortgeschritten / All-Mountain',
        modifier: '+1 Zeilensprung',
        speed: 'Zügiges bis schnelles Fahren',
        terrain: 'Rote Pisten und abwechslungsreiches Gelände',
        release: 'Ausgewogene Balance aus sicherem Halt und Auslösung',
        description: 'Umfasst die Mehrheit aller erwachsenen Skifahrer. Verlässlicher Halt bei gecarvten Schwüngen, kombiniert mit rechtzeitiger Freigabe bei Stürzen mit höherer kinetischer Energie.'
      },
      {
        code: 'Typ III',
        title: 'Sportlich / Experte',
        modifier: '+2 Zeilensprünge',
        speed: 'Sehr schnell in steilem Gelände',
        terrain: 'Schwarze Pisten, Buckelpisten und Tiefschnee',
        release: 'Hohe Haltekraft; löst nur bei schweren Stürzen aus',
        description: 'Sehr versierte Skifahrer, die aggressive Fliehkräfte erzeugen. Ein unbeabsichtigtes Auslösen im Steilhang stellt hier das größere Sicherheitsrisiko dar.'
      },
      {
        code: 'Typ III+',
        title: 'Rennläufer / Extrem-Freeride',
        modifier: '+3 Zeilensprünge (Hersteller)',
        speed: 'Wettkampftempo / Klippensprünge',
        terrain: 'FIS-Rennstrecken und extreme Steilrinnen',
        release: 'Maximale mechanische Haltekraft',
        description: 'Elite-Rennläufer, die das Risiko von Bänderverletzungen bewusst in Kauf nehmen, um Stürze durch Fehlauslösungen bei extremen Geschwindigkeiten zu verhindern.'
      }
    ]
  },
  fr: {
    badge: 'PROFIL DE SKIEUR ISO 11088',
    title: 'Classification des Types de Skieurs',
    desc: 'Votre profil de skieur détermine l\'équilibre mécanique fondamental entre le déclenchement salvateur en cas de chute et la rétention à grande vitesse.',
    isoModifierLabel: 'Modificateur ISO :',
    speedLabel: 'Vitesse souhaitée',
    terrainLabel: 'Terrain typique',
    releaseLabel: 'Déclenchement vs Rétention',
    safetyTitle: 'Pourquoi vous ne devez jamais surévaluer votre type de skieur',
    safetyP1: 'Beaucoup de skieurs de niveau moyen choisissent le Type III en pensant qu\'un chiffre supérieur reflète un meilleur niveau. En pratique, skier en Type III sans générer les contraintes physiques associées empêche la fixation de s\'ouvrir lors d\'une chute en torsion, provoquant des ruptures des ligaments croisés.',
    safetyP2: 'Choisissez systématiquement le type le plus bas qui évite les déclenchements intempestifs lors de votre pratique habituelle.',
    types: [
      {
        code: 'Type -I',
        title: 'Extrêmement Prudent',
        modifier: '-1 Ligne',
        speed: 'Très lente sur pentes faibles',
        terrain: 'Espaces débutants et pistes vertes',
        release: 'Déclenchement au moindre déséquilibre',
        description: 'Conçu pour les jeunes enfants, les vrais débutants ou les skieurs avec fragilités articulaires souhaitant une libération immédiate.'
      },
      {
        code: 'Type I',
        title: 'Prudent / Débutant',
        modifier: '0 Ligne (Ligne de base)',
        speed: 'Allure modérée et contrôlée',
        terrain: 'Pistes vertes et bleues damées',
        release: 'Libère facilement pour protéger les genoux',
