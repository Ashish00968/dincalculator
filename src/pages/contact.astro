---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Contact Us | DIN Calculator Pro";
const pageDescription = "Get in touch with the DIN Calculator Pro team. Report issues, ask questions, or provide feedback about our free ISO 11088 ski binding calculator.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.04]" style="background-image: linear-gradient(var(--theme-hairline) 1px, transparent 1px), linear-gradient(90deg, var(--theme-hairline) 1px, transparent 1px); background-size: 48px 48px;"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-14 sm:pt-28 sm:pb-20 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-hairline bg-parchment text-mute text-[11px] font-semibold tracking-widest uppercase mb-8 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
        Get In Touch
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-ink tracking-tight leading-tight mb-6">
        We'd love to <span class="text-primary">hear from you.</span>
      </h1>
      <p class="text-mute text-lg max-w-xl mx-auto leading-relaxed">
        Have a question, found a bug, or want to suggest an improvement? Send us a message and we'll get back to you.
      </p>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Contact Info Cards -->
      <div class="space-y-4">
        <h2 class="text-lg font-bold text-ink mb-6">Contact Information</h2>

        <div class="p-5 rounded-2xl bg-parchment border border-hairline space-y-2">
          <div class="w-9 h-9 rounded-xl bg-primary/10 flex items-center justify-center text-primary mb-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <div class="font-semibold text-ink text-sm">Email</div>
          <a href="mailto:hello@dincalculatorpro.com" class="text-primary text-sm hover:underline">hello@dincalculatorpro.com</a>
        </div>

        <div class="p-5 rounded-2xl bg-parchment border border-hairline space-y-2">
          <div class="w-9 h-9 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-500 mb-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div class="font-semibold text-ink text-sm">Response Time</div>
          <p class="text-mute text-xs leading-relaxed">We typically respond within 24–48 hours on business days.</p>
        </div>

        <div class="p-5 rounded-2xl bg-parchment border border-hairline space-y-2">
          <div class="w-9 h-9 rounded-xl bg-cyan-500/10 flex items-center justify-center text-cyan-500 mb-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <div class="font-semibold text-ink text-sm">Privacy</div>
          <p class="text-mute text-xs leading-relaxed">Your email is only used to reply to you. We do not add you to any mailing list.</p>
        </div>

        <!-- FAQ shortcut -->
        <div class="pt-4">
          <p class="text-xs text-mute mb-2">Looking for quick answers?</p>
          <a href="/#faq" class="text-sm text-primary font-medium hover:underline flex items-center gap-1">
            View our FAQ
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="md:col-span-2">
        <h2 class="text-lg font-bold text-ink mb-6">Send a Message</h2>
        
        <!-- Success Card (hidden by default) -->
        <div id="form-success" class="hidden p-8 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-center space-y-4 animate-in fade-in zoom-in-95 duration-300">
          <div class="w-14 h-14 rounded-full bg-emerald-500/20 text-emerald-500 flex items-center justify-center mx-auto">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-ink mb-1">Message Sent Successfully!</h3>
            <p class="text-mute text-sm max-w-md mx-auto leading-relaxed" id="success-desc">
              Thank you for reaching out. We've received your note and will get back to you at <strong class="text-ink font-semibold" id="success-email-display">your email</strong> within 24–48 hours.
            </p>
          </div>
          <button
            type="button"
            id="reset-form-btn"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold tracking-wide transition-all shadow-md mt-2"
          >
            Send Another Message
          </button>
        </div>

        <!-- Error Card (hidden by default) -->
        <div id="form-error" class="hidden p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-500 text-sm mb-5 flex items-start gap-3">
          <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div class="flex-1">
            <p class="font-semibold" id="error-title">Unable to send message directly.</p>
            <p class="text-xs text-red-400 mt-0.5" id="error-msg">
              Please email us directly at <a href="mailto:hello@dincalculatorpro.com" class="underline font-bold hover:text-red-300">hello@dincalculatorpro.com</a>.
            </p>
          </div>
        </div>

        <!-- Main Form -->
        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-5"
        >
          <!-- Web3Forms Access Key -->
          <input type="hidden" name="access_key" id="access-key" value="349f390f-89ff-41ea-a4b2-bf176edd39a7" />
          <input type="hidden" name="from_name" value="DIN Calculator Pro Form" />
          <input type="hidden" name="subject" id="hidden-subject" value="[DIN Calculator Pro] Contact Form Inquiry" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="space-y-1.5">
              <label for="contact-name" class="text-xs font-semibold text-mute uppercase tracking-wider">Name</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                placeholder="Your name"
                required
                class="w-full px-4 py-3 rounded-xl bg-parchment border border-hairline text-ink text-sm placeholder:text-mute/60 focus:outline-none focus:border-primary/60 focus:ring-2 focus:ring-primary/10 transition-all"
              />
            </div>
            <div class="space-y-1.5">
              <label for="contact-email" class="text-xs font-semibold text-mute uppercase tracking-wider">Email</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                placeholder="you@example.com"
                required
                class="w-full px-4 py-3 rounded-xl bg-parchment border border-hairline text-ink text-sm placeholder:text-mute/60 focus:outline-none focus:border-primary/60 focus:ring-2 focus:ring-primary/10 transition-all"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="contact-subject" class="text-xs font-semibold text-mute uppercase tracking-wider">Subject</label>
            <select
              id="contact-subject"
              name="topic"
              class="w-full px-4 py-3 rounded-xl bg-parchment border border-hairline text-ink text-sm focus:outline-none focus:border-primary/60 focus:ring-2 focus:ring-primary/10 transition-all appearance-none cursor-pointer"
            >
              <option value="General Question">General Question</option>
              <option value="Bug Report">Bug Report</option>
              <option value="Feedback / Suggestion">Feedback / Suggestion</option>
              <option value="Partnership / Media">Partnership / Media</option>
              <option value="Technical Issue">Technical Issue</option>
            </select>
          </div>

          <div class="space-y-1.5">
            <label for="contact-message" class="text-xs font-semibold text-mute uppercase tracking-wider">Message</label>
            <textarea
              id="contact-message"
              name="message"
              rows="6"
              placeholder="Tell us how we can help..."
              required
              class="w-full px-4 py-3 rounded-xl bg-parchment border border-hairline text-ink text-sm placeholder:text-mute/60 focus:outline-none focus:border-primary/60 focus:ring-2 focus:ring-primary/10 transition-all resize-none"
            ></textarea>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2">
            <button
              type="submit"
              id="submit-btn"
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-primary text-white font-semibold text-sm transition-all hover:opacity-90 hover:scale-[1.02] active:scale-[0.98] shadow-lg disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
              style="box-shadow: 0 4px 24px -4px color-mix(in srgb, var(--theme-primary) 50%, transparent);"
            >
              <span id="btn-text">Send Message</span>
              <svg id="btn-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
              </svg>
              <svg id="btn-spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>

            <span class="text-xs text-mute flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Delivered straight to hello@dincalculatorpro.com
            </span>
          </div>
        </form>

        <script is:inline>
          const form = document.getElementById('contact-form');
          const submitBtn = document.getElementById('submit-btn');
          const btnText = document.getElementById('btn-text');
          const btnIcon = document.getElementById('btn-icon');
          const btnSpinner = document.getElementById('btn-spinner');
          const formSuccess = document.getElementById('form-success');
          const formError = document.getElementById('form-error');
          const errorMsg = document.getElementById('error-msg');
          const resetBtn = document.getElementById('reset-form-btn');
          const successEmailDisplay = document.getElementById('success-email-display');
          const subjectSelect = document.getElementById('contact-subject');
          const hiddenSubject = document.getElementById('hidden-subject');
          const accessKeyInput = document.getElementById('access-key');

          if (form && submitBtn) {
            form.addEventListener('submit', async (e) => {
              e.preventDefault();

              // Update subject line with selected topic
              if (subjectSelect && hiddenSubject) {
                hiddenSubject.value = `[DIN Calculator Pro] ${subjectSelect.value}`;
              }

              const formData = new FormData(form);
              const userEmail = formData.get('email');
              const userName = formData.get('name');
              const message = formData.get('message');
              const topic = formData.get('topic');

              // Check if Web3Forms key is still default placeholder
              const accessKey = accessKeyInput ? accessKeyInput.value : '';
              if (accessKey === 'YOUR_ACCESS_KEY_HERE' || !accessKey) {
                // Fallback to formatted mailto dispatch if key is not yet set
                const mailtoSubject = encodeURIComponent(`[DIN Calculator Pro] ${topic}`);
                const mailtoBody = encodeURIComponent(`Name: ${userName}\nEmail: ${userEmail}\nTopic: ${topic}\n\nMessage:\n${message}`);
                window.location.href = `mailto:hello@dincalculatorpro.com?subject=${mailtoSubject}&body=${mailtoBody}`;
                return;
              }

              // Set loading UI state
              submitBtn.disabled = true;
              btnText.textContent = 'Sending...';
              btnIcon.classList.add('hidden');
              btnSpinner.classList.remove('hidden');
              formError.classList.add('hidden');

              try {
                const response = await fetch('https://api.web3forms.com/submit', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                  },
                  body: JSON.stringify(Object.fromEntries(formData)),
                });

                const result = await response.json();

                if (response.status === 200 && result.success) {
                  // Show success UI
                  form.classList.add('hidden');
                  formSuccess.classList.remove('hidden');
                  if (successEmailDisplay) {
                    successEmailDisplay.textContent = userEmail;
                  }
                  form.reset();
                } else {
                  throw new Error(result.message || 'Submission failed');
                }
              } catch (err) {
                console.error('Form submission error:', err);
                formError.classList.remove('hidden');
                if (errorMsg) {
                  errorMsg.innerHTML = `Submission error. You can also send directly via <a href="mailto:hello@dincalculatorpro.com" class="underline font-bold hover:text-red-300">hello@dincalculatorpro.com</a>.`;
                }
              } finally {
                submitBtn.disabled = false;
                btnText.textContent = 'Send Message';
                btnIcon.classList.remove('hidden');
                btnSpinner.classList.add('hidden');
              }
            });

            if (resetBtn) {
              resetBtn.addEventListener('click', () => {
                formSuccess.classList.add('hidden');
                formError.classList.add('hidden');
                form.classList.remove('hidden');
              });
            }
          }
        </script>
      </div>
    </div>

    <!-- Topics -->
    <div class="mt-16 pt-12 border-t border-hairline">
      <h2 class="text-lg font-bold text-ink mb-6 text-center">What Can We Help With?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {[
          { icon: "🐛", title: "Bug Reports", desc: "Did a calculation seem wrong? Found a display issue? Let us know with your browser and OS details." },
          { icon: "💡", title: "Feature Requests", desc: "Want PDF export? A specific language? A new binding database? We're all ears." },
          { icon: "🤝", title: "Partnerships", desc: "Ski shop owners, bloggers, and ski schools — reach out about partnerships or embedding." }
        ].map(item => (
          <div class="p-5 rounded-2xl bg-parchment border border-hairline space-y-2">
            <span class="text-2xl">{item.icon}</span>
            <h3 class="font-semibold text-ink text-sm">{item.title}</h3>
            <p class="text-xs text-mute leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
