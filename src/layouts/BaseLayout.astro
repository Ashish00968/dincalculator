---
import '../styles/global.css';
import { ThemeToggle } from '../components/ui/ThemeToggle';
import { getLangFromUrl, useTranslations, getRouteFromUrl, hasLocalizedRoutes } from '../i18n/utils';
import { languages } from '../i18n/ui';
import { isIndexablePath, INDEXABLE_LOCALES } from '../i18n/config';
import { getSeoMetadata, getStructuredData } from '../utils/seo';
import LanguageSelector from '../components/ui/LanguageSelector.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  canonicalUrl?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const hasTranslations = hasLocalizedRoutes(Astro.url);
const isIndexable = isIndexablePath(Astro.url.pathname);

const siteUrl = 'https://dincalculatorpro.com';
const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;

const seoMeta = getSeoMetadata(Astro.url.pathname, lang);
const title = (Astro.props.title && Astro.props.title.length <= 60 && !Astro.props.title.includes('undefined')) 
  ? Astro.props.title 
  : seoMeta.title;

const description = (Astro.props.description && Astro.props.description.length >= 110 && Astro.props.description.length <= 165)
  ? Astro.props.description
  : seoMeta.description;

const ogType = Astro.props.ogType || 'website';
const canonicalUrl = Astro.props.canonicalUrl || `${siteUrl}${normalizedPath}`;

const navLinks = [
  { href: getRouteFromUrl(new URL('/', siteUrl), lang), label: t('nav.calculator'), base: '/' },
  { href: getRouteFromUrl(new URL('/din-chart/', siteUrl), lang), label: t('nav.matrix'), base: '/din-chart/' },
  { href: getRouteFromUrl(new URL('/bsl-guide/', siteUrl), lang), label: t('nav.bsl'), base: '/bsl-guide/' },
  { href: getRouteFromUrl(new URL('/skier-types/', siteUrl), lang), label: t('nav.skierTypes'), base: '/skier-types/' },
  { href: getRouteFromUrl(new URL('/about/', siteUrl), lang), label: t('nav.about'), base: '/about/' },
];

const structuredData = getStructuredData(Astro.url.pathname, lang, title, description);
---

<!doctype html>
<html lang={lang} class="scroll-smooth dark">
  <head>
    <!-- Self-hosted Fonts via @fontsource (Zero external font blocking) -->
    <!-- Privacy-first cookieless analytics: No GA4 / No tracking cookies -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Robots / Indexing Control -->
    {!isIndexable && <meta name="robots" content="noindex, follow" />}
    
    <!-- Hreflang Tags for SEO (Only reciprocal among indexable locales) -->
    {isIndexable && hasTranslations && INDEXABLE_LOCALES.map((l) => (
      <link rel="alternate" hreflang={l} href={`${siteUrl}${getRouteFromUrl(Astro.url, l as keyof typeof languages)}`} />
    ))}
    {isIndexable && hasTranslations && (
      <link rel="alternate" hreflang="x-default" href={`${siteUrl}${getRouteFromUrl(Astro.url, 'en')}`} />
    )}

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="DIN Calculator Pro" />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DIN Calculator Pro - Ski Binding Release Settings" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />

    <!-- Favicon & Web App Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#090A0C" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F8FAFC" media="(prefers-color-scheme: light)" />

    <!-- Inline Theme Script to avoid FOUC -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-canvas text-primary font-sans antialiased min-h-screen flex flex-col selection:bg-accent/30 selection:text-primary">
    <!-- Sticky Developer-Platform Navigation Bar -->
    <header class="sticky top-0 z-50 bg-canvas/80 backdrop-blur-md border-b border-hairline transition-all">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Logo -->
        <a href={getRouteFromUrl(new URL('/', siteUrl), lang)} class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl overflow-hidden shrink-0 shadow-sm group-hover:ring-2 group-hover:ring-orange-500/40 transition-all">
            <img src="/logo-icon.webp" alt="" aria-hidden="true" width="36" height="36" decoding="async" class="w-full h-full object-cover" />
          </div>
          <span class="text-sm font-bold tracking-tight text-ink group-hover:text-primary transition-colors">
            DIN Calculator <span class="text-primary">Pro</span>
          </span>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-1 bg-input/80 p-1 rounded-full border border-hairline shadow-inner">
          {navLinks.map((link) => {
            const isActive = currentPath === link.href || (link.href !== `/${lang === 'en' ? '' : lang}` && currentPath.startsWith(link.href) && link.base !== '/');
            return (
              <a
                href={link.href}
                class={`px-4 py-1.5 rounded-full text-xs font-medium transition-all ${
                  isActive
                    ? 'text-primary bg-canvas shadow-sm border border-hairline'
                    : 'text-mute hover:text-primary hover:bg-canvas/40'
                }`}
              >
                {link.label}
              </a>
            );
          })}
        </nav>

        <!-- Right Action Badge -->
        <div class="flex items-center gap-3">
          <LanguageSelector />
          <ThemeToggle client:idle />

          <!-- Mobile Menu Button -->
          <button
            id="mobile-menu-btn"
            class="md:hidden p-2 rounded-lg bg-input border border-hairline text-mute hover:text-primary"
            aria-label="Toggle menu"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Navigation -->
      <div id="mobile-menu" class="hidden md:hidden px-4 pt-2 pb-4 border-b border-hairline bg-canvas space-y-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="block px-3 py-2 rounded-md text-sm font-medium text-mute hover:text-primary hover:bg-parchment"
          >
            {link.label}
          </a>
        ))}
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-1 relative z-10">
      <slot />
    </main>

    <!-- Global Developer-Platform Footer -->
    <footer class="bg-canvas border-t border-hairline mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <!-- Safety Alert Band -->
        <div class="mb-14 p-6 rounded-2xl bg-parchment border border-amber-500/30 flex flex-col md:flex-row items-start gap-4 shadow-sm">
          <div class="p-2 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-500 shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div class="space-y-1.5 text-xs sm:text-sm">
            <p class="font-semibold text-primary">Mandatory ISO 11088 Safety Notice</p>
            <p class="text-mute leading-relaxed">
              {t('footer.disclaimer')}
            </p>
          </div>
        </div>

        <!-- Footer Links Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 mb-12 text-sm">
          <div class="space-y-3 lg:col-span-1">
            <div class="flex items-center gap-2.5 text-primary font-bold">
              <div class="w-7 h-7 rounded-lg overflow-hidden shrink-0 shadow-sm">
                <img src="/logo-icon.webp" alt="" aria-hidden="true" width="28" height="28" decoding="async" class="w-full h-full object-cover" />
              </div>
              <span class="text-base tracking-tight">DIN Calculator <span class="text-accent">Pro</span></span>
            </div>
            <p class="text-mute text-xs leading-relaxed">
              {t('meta.description')}
            </p>
          </div>

          <div>
            <h4 class="caption-mono text-mute mb-3">Tools & Charts</h4>
            <ul class="space-y-2 text-xs text-mute">
              <li><a href={getRouteFromUrl(new URL('/', siteUrl), lang)} class="hover:text-primary transition-colors">{t('nav.calculator')}</a></li>
              <li><a href={getRouteFromUrl(new URL('/din-chart/', siteUrl), lang)} class="hover:text-primary transition-colors">{t('nav.matrix')}</a></li>
              <li><a href="/kids-din-chart/" class="hover:text-primary transition-colors">Kids DIN Chart</a></li>
              <li><a href="/din-setting-by-weight/" class="hover:text-primary transition-colors">DIN by Weight</a></li>
              <li><a href="/skier-type-quiz/" class="hover:text-primary transition-colors">Skier Type Quiz</a></li>
              <li><a href="/embed-guide/" class="hover:text-primary transition-colors">Embed Widget</a></li>
            </ul>
          </div>

          <div>
            <h4 class="caption-mono text-mute mb-3">Guides & Safety</h4>
            <ul class="space-y-2 text-xs text-mute">
              <li><a href={getRouteFromUrl(new URL('/bsl-guide/', siteUrl), lang)} class="hover:text-primary transition-colors">{t('nav.bsl')}</a></li>
              <li><a href={getRouteFromUrl(new URL('/skier-types/', siteUrl), lang)} class="hover:text-primary transition-colors">{t('nav.skierTypes')}</a></li>
              <li><a href="/gripwalk-vs-alpine-vs-wtr/" class="hover:text-primary transition-colors">GripWalk vs Alpine</a></li>
              <li><a href="/din-vs-z-value/" class="hover:text-primary transition-colors">DIN vs Z-Value</a></li>
              <li><a href="/how-to-adjust-ski-bindings/" class="hover:text-primary transition-colors">Binding Adjustment</a></li>
              <li><a href="/din-too-high-or-too-low/" class="hover:text-primary transition-colors">DIN Too High or Low</a></li>
            </ul>
          </div>

          <div>
            <h4 class="caption-mono text-mute mb-3">Standards & Tech</h4>
            <ul class="space-y-2 text-xs text-mute">
              <li><a href="/iso-11088-2023-changes/" class="hover:text-primary transition-colors"><span class="text-primary font-medium">ISO 11088:2023</span> (Ed. 7)</a></li>
              <li><span class="text-primary font-medium">ISO 9462</span> (Alpine Bindings)</li>
              <li><span class="text-primary font-medium">ISO 5355</span> (Alpine Boot Soles)</li>
              <li><span class="text-primary font-medium">ISO 23223</span> (GripWalk Soles)</li>
              <li><span class="text-primary font-medium">ASTM F1063</span> (Inspection Standard)</li>
            </ul>
          </div>

          <div>
            <h4 class="caption-mono text-mute mb-3">Company & Trust</h4>
            <ul class="space-y-2 text-xs text-mute">
              <li><a href={getRouteFromUrl(new URL('/about/', siteUrl), lang)} class="hover:text-primary transition-colors">{t('nav.about')}</a></li>
              <li><a href="/methodology/" class="hover:text-primary transition-colors">Methodology</a></li>
              <li><a href="/changelog/" class="hover:text-primary transition-colors">Changelog</a></li>
              <li><a href={getRouteFromUrl(new URL('/contact/', siteUrl), lang)} class="hover:text-primary transition-colors">{t('nav.contact')}</a></li>
              <li><a href={getRouteFromUrl(new URL('/terms/', siteUrl), lang)} class="hover:text-primary transition-colors">{t('nav.terms')}</a></li>
              <li><a href={getRouteFromUrl(new URL('/privacy/', siteUrl), lang)} class="hover:text-primary transition-colors">{t('nav.privacy')}</a></li>
              <li class="text-emerald-500 pt-1 flex items-center gap-1">
                <span>●</span> Cookieless • No Tracking
              </li>
            </ul>
          </div>
        </div>

        <!-- Copyright & Attribution -->
        <div class="pt-8 border-t border-hairline flex flex-col sm:flex-row items-center justify-between text-xs text-mute gap-4">
          <p>© {new Date().getFullYear()} DIN Calculator Pro. Independent project, not affiliated with ISO or binding manufacturers. Methodology based on ISO 11088:2023.</p>
          <p class="font-mono text-[11px]">Client-Side Only • Device Storage Only • MIT License</p>
        </div>
      </div>
    </footer>

    <!-- Mobile menu toggle script -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>
